+++ b/chrome/browser/prts/prts_window_registry.cc
@@ -0,0 +1,465 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/prts/prts_window_registry.h"
+
+#include <bit>
+#include <cmath>
+#include <map>
+#include <set>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/ui/browser_window/public/browser_collection_observer.h"
+#include "chrome/browser/ui/browser_window/public/create_browser_window.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/base/base_window.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
+                                 public TabStripModelObserver {
+ public:
+  explicit Impl(PrtsTargetRegistry::SendCallback send)
+      : send_(std::move(send)) {}
+  ~Impl() override {
+    observation_.Reset();
+    for (const auto& [id, w] : windows_) {
+      w.browser->GetTabStripModel()->RemoveObserver(this);
+    }
+  }
+  struct Size {
+    uint32_t width = 960, height = 640;
+    double dpr = 1;
+  };
+  struct Window {
+    uint64_t id, source;
+    raw_ptr<BrowserWindowInterface> browser;
+    Size size;
+    uint64_t generation = 1;
+    bool announced = false, closing = false;
+  };
+  class Tab : public content::WebContentsObserver {
+   public:
+    Tab(Impl* owner, content::WebContents* contents, uint64_t id)
+        : WebContentsObserver(contents), owner(owner), id(id) {}
+    void DidStartLoading() override { owner->Schedule(); }
+    void DidStopLoading() override { owner->Schedule(); }
+    void TitleWasSet(content::NavigationEntry*) override { owner->Schedule(); }
+    void DidFinishNavigation(content::NavigationHandle*) override {
+      owner->Schedule();
+    }
+    void WebContentsDestroyed() override {
+      Observe(nullptr);
+      owner->Schedule();
+    }
+    void Replace(content::WebContents* contents) { Observe(contents); }
+    raw_ptr<Impl> owner;
+    const uint64_t id;
+    uint64_t opener = 0;
+  };
+  void Start() {
+    observation_.Observe(GlobalBrowserCollection::GetInstance());
+    prts::Encoder e;
+    for (uint32_t v : {2u, 0u, 256u, 2u}) {
+      e.Int(v, 4);
+    }
+    e.Int(512ull * 1024 * 1024, 8);
+    e.Int(512ull * 1024 * 1024, 8);
+    e.Int(1, 4);
+    e.Int(1, 4);
+    send_.Run(0x494, 0, std::move(e.data));
+    GlobalBrowserCollection::GetInstance()->ForEach(
+        [this](BrowserWindowInterface* browser) {
+          OnBrowserCreated(browser);
+          return true;
+        });
+  }
+  void Error(uint64_t request, uint32_t code, const char* message) {
+    prts::Encoder e;
+    e.Int(code, 4);
+    e.String(message);
+    e.Int(0, 1);
+    send_.Run(3, request, std::move(e.data));
+  }
+  void Schedule() {
+    if (pending_) {
+      return;
+    }
+    pending_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&Impl::Reconcile, weak_.GetWeakPtr()));
+  }
+  Tab* Find(content::WebContents* contents) {
+    for (auto& [id, t] : tabs_) {
+      if (t->web_contents() == contents) {
+        return t.get();
+      }
+    }
+    return nullptr;
+  }
+  Tab* Track(content::WebContents* contents) {
+    if (auto* t = Find(contents)) {
+      return t;
+    }
+    auto t = std::make_unique<Tab>(this, contents, ++next_);
+    if (auto* opener =
+            Find(contents->GetFirstWebContentsInLiveOriginalOpenerChain())) {
+      t->opener = opener->id;
+    }
+    auto* result = t.get();
+    tabs_.emplace(t->id, std::move(t));
+    return result;
+  }
+  void TabSnapshot(prts::Encoder& e,
+                   Window& w,
+                   content::WebContents* contents) {
+    auto* t = Track(contents);
+    e.Int(t->id, 8);
+    e.Int(w.id, 8);
+    e.Int(t->opener, 8);
+    e.String(
+        base::TruncateUTF8ToByteSize(contents->GetVisibleURL().spec(), 65536));
+    e.String(base::TruncateUTF8ToByteSize(
+        base::UTF16ToUTF8(contents->GetTitle()), 65536));
+    e.Int(contents->IsLoading() ? 1 : 2, 1);
+    e.Int(w.browser->GetTabStripModel()->GetActiveWebContents() == contents, 1);
+  }
+  std::vector<uint8_t> Snapshot(Window& w) {
+    auto* strip = w.browser->GetTabStripModel();
+    prts::Encoder e;
+    e.Int(w.id, 8);
+    e.Int(w.browser->GetType() == BrowserWindowInterface::TYPE_NORMAL ? 1 : 2,
+          1);
+    e.Int(0, 8);
+    e.Int(w.size.width, 4);
+    e.Int(w.size.height, 4);
+    e.Int(std::bit_cast<uint64_t>(w.size.dpr), 8);
+    e.Int(w.generation, 8);
+    auto* active = strip->GetActiveWebContents();
+    e.Int(active ? Track(active)->id : 0, 8);
+    e.Int(input_ == w.id, 1);
+    e.Int(w.closing, 1);
+    e.Int(strip->count(), 4);
+    for (int i = 0; i < strip->count(); ++i) {
+      TabSnapshot(e, w, strip->GetWebContentsAt(i));
+    }
+    return std::move(e.data);
+  }
+  void Publish(Window& w) {
+    auto bytes = Snapshot(w);
+    auto it = snapshots_.find(w.id);
+    if (!w.announced || it == snapshots_.end() || it->second != bytes) {
+      snapshots_[w.id] = bytes;
+      send_.Run(w.announced ? 0x491 : 0x490, 0, std::move(bytes));
+      w.announced = true;
+    }
+  }
+  void Reconcile() {
+    pending_ = false;
+    if (mutating_) {
+      Schedule();
+      return;
+    }
+    for (auto it = tabs_.begin(); it != tabs_.end();) {
+      if (!it->second->web_contents()) {
+        it = tabs_.erase(it);
+      } else {
+        ++it;
+      }
+    }
+    for (auto& [id, w] : windows_) {
+      Publish(w);
+    }
+  }
+  void OnBrowserCreated(BrowserWindowInterface* browser) override {
+    for (const auto& [id, w] : windows_) {
+      if (w.browser == browser) {
+        return;
+      }
+    }
+    uint64_t id = ++next_, source = ++next_;
+    windows_.emplace(id, Window{id, source, browser, {}});
+    browser->GetTabStripModel()->AddObserver(this);
+    Schedule();
+  }
+  void OnBrowserClosed(BrowserWindowInterface* browser) override {
+    for (auto it = windows_.begin(); it != windows_.end(); ++it) {
+      if (it->second.browser != browser) {
+        continue;
+      }
+      browser->GetTabStripModel()->RemoveObserver(this);
+      auto id = it->first;
+      bool announced = it->second.announced;
+      windows_.erase(it);
+      snapshots_.erase(id);
+      if (input_ == id) {
+        input_ = 0;
+      }
+      if (announced) {
+        prts::Encoder e;
+        e.Int(id, 8);
+        e.String("closed");
+        send_.Run(0x492, 0, std::move(e.data));
+      }
+      return;
+    }
+  }
+  void OnTabStripModelChanged(TabStripModel*,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange&) override {
+    if (change.type() == TabStripModelChange::kReplaced) {
+      auto* r = change.GetReplace();
+      if (auto* t = Find(r->old_contents)) {
+        t->Replace(r->new_contents);
+      }
+    }
+    Schedule();
+  }
+  bool ReadSize(prts::Decoder& d, Size& size) {
+    size.width = d.Int(4);
+    size.height = d.Int(4);
+    size.dpr = std::bit_cast<double>(d.Int(8));
+    return size.width && size.width <= 8192 && size.height &&
+           size.height <= 8192 && std::isfinite(size.dpr) && size.dpr >= .5 &&
+           size.dpr <= 4 &&
+           std::ceil(size.width * size.dpr) *
+                   std::ceil(size.height * size.dpr) <=
+               64000000;
+  }
+  void Handle(const prts::Record& r) {
+    prts::Decoder d(r.payload);
+    if (r.type == 0x402) {
+      if (!d.Done()) {
+        Error(r.id, 1, "Invalid window list");
+        return;
+      }
+      Reconcile();
+      prts::Encoder e;
+      e.Int(windows_.size(), 4);
+      for (auto& [id, w] : windows_) {
+        auto bytes = Snapshot(w);
+        e.data.insert(e.data.end(), bytes.begin(), bytes.end());
+      }
+      send_.Run(0x481, r.id, std::move(e.data));
+      return;
+    }
+    if (r.type == 0x400) {
+      auto url = d.String();
+      Size size;
+      bool valid = ReadSize(d, size);
+      auto activate = d.Int(1);
+      if (!valid || activate > 1 || !d.Done() || !GURL(url).is_valid() ||
+          url.find('\0') != std::string::npos) {
+        Error(r.id, 1, "Invalid window create");
+        return;
+      }
+      if (windows_.size() >= 2) {
+        Error(r.id, 5, "Window capacity");
+        return;
+      }
+      mutating_ = true;
+      BrowserWindowCreateParams create(BrowserWindowInterface::TYPE_NORMAL,
+                                       *ProfileManager::GetLastUsedProfile(),
+                                       false);
+      auto* browser = CreateBrowserWindow(std::move(create));
+      NavigateParams params(browser, GURL(url), ui::PAGE_TRANSITION_TYPED);
+      params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+      params.window_action = NavigateParams::WindowAction::kShowWindowInactive;
+      Navigate(&params);
+      OnBrowserCreated(browser);
+      mutating_ = false;
+      for (auto& [id, w] : windows_) {
+        if (w.browser == browser) {
+          w.size = size;
+          if (activate) {
+            input_ = id;
+          }
+          Reconcile();
+          send_.Run(0x480, r.id, Snapshot(w));
+          return;
+        }
+      }
+      Error(r.id, 9, "Window creation failed");
+      return;
+    }
+    auto id = d.Int(8);
+    // Standalone acceptance driver only. These invoke real TabStripModel
+    // operations, including its replacement and cross-window detach observers.
+    if ((r.type == 0x42e || r.type == 0x42f) &&
+        base::CommandLine::ForCurrentProcess()->HasSwitch("prts-test-hooks")) {
+      auto destination = r.type == 0x42e ? d.Int(8) : 0;
+      auto it = tabs_.find(id);
+      if (!d.Done()) {
+        Error(r.id, 1, "Malformed test operation");
+        return;
+      }
+      if (it == tabs_.end() || !it->second->web_contents()) {
+        Error(r.id, 2, "Unknown test tab");
+        return;
+      }
+      auto* contents = it->second->web_contents();
+      auto* browser =
+          GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(contents);
+      if (!browser) {
+        Error(r.id, 4, "Detached test tab");
+        return;
+      }
+      auto* strip = browser->GetTabStripModel();
+      if (r.type == 0x42e) {
+        auto dest = windows_.find(destination);
+        if (dest == windows_.end() || dest->second.browser == browser) {
+          Error(r.id, 2, "Unknown/cross-owner destination");
+          return;
+        }
+        auto moved = strip->DetachWebContentsAtForInsertion(
+            strip->GetIndexOfWebContents(contents));
+        auto* other = dest->second.browser->GetTabStripModel();
+        other->InsertWebContentsAt(other->count(), std::move(moved),
+                                   ADD_ACTIVE);
+      } else {
+        auto replacement = content::WebContents::Create(
+            content::WebContents::CreateParams(browser->GetProfile()));
+        auto old = strip->DiscardWebContents(contents, std::move(replacement));
+      }
+      Reconcile();
+      send_.Run(7, r.id, {});
+      return;
+    }
+    if (r.type >= 0x420 && r.type <= 0x423) {
+      std::string url;
+      auto activate = uint64_t{0};
+      if (r.type == 0x420 || r.type == 0x423) {
+        url = d.String();
+      }
+      if (r.type == 0x420) {
+        activate = d.Int(1);
+      }
+      if (!d.Done() || activate > 1 ||
+          ((r.type == 0x420 || r.type == 0x423) &&
+           (!GURL(url).is_valid() || url.find('\0') != std::string::npos))) {
+        Error(r.id, 1, "Invalid tab command");
+        return;
+      }
+      Window* owner = nullptr;
+      Tab* tab = nullptr;
+      if (r.type == 0x420) {
+        auto it = windows_.find(id);
+        if (it != windows_.end()) {
+          owner = &it->second;
+        }
+      } else {
+        auto it = tabs_.find(id);
+        if (it != tabs_.end() && it->second->web_contents()) {
+          tab = it->second.get();
+          auto* browser =
+              GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+                  tab->web_contents());
+          for (auto& [wid, w] : windows_) {
+            if (w.browser == browser) {
+              owner = &w;
+            }
+          }
+        }
+      }
+      if (!owner || owner->closing) {
+        Error(r.id, 2, "Unknown or unavailable tab/window");
+        return;
+      }
+      auto* strip = owner->browser->GetTabStripModel();
+      if (r.type == 0x420) {
+        if (tabs_.size() >= 256) {
+          Error(r.id, 5, "Tab capacity");
+          return;
+        }
+        NavigateParams params(owner->browser, GURL(url),
+                              ui::PAGE_TRANSITION_TYPED);
+        params.disposition = activate
+                                 ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                                 : WindowOpenDisposition::NEW_BACKGROUND_TAB;
+        Navigate(&params);
+        if (!params.navigated_or_inserted_contents) {
+          Error(r.id, 9, "Tab creation failed");
+          return;
+        }
+        tab = Track(params.navigated_or_inserted_contents);
+      } else if (r.type == 0x421) {
+        strip->CloseWebContents(tab->web_contents(), 0);
+        Reconcile();
+        send_.Run(7, r.id, {});
+        return;
+      } else if (r.type == 0x422) {
+        strip->ActivateTabAt(strip->GetIndexOfWebContents(tab->web_contents()));
+      } else {
+        tab->web_contents()->GetController().LoadURL(
+            GURL(url), content::Referrer(), ui::PAGE_TRANSITION_TYPED, "");
+        Reconcile();
+        send_.Run(7, r.id, {});
+        return;
+      }
+      Reconcile();
+      prts::Encoder e;
+      TabSnapshot(e, *owner, tab->web_contents());
+      send_.Run(0x482, r.id, std::move(e.data));
+      return;
+    }
+    if (!d.Done() || (r.type != 0x401 && r.type != 0x404)) {
+      Error(r.id, 1, "Unsupported or malformed window command");
+      return;
+    }
+    auto it = windows_.find(id);
+    if (it == windows_.end()) {
+      Error(r.id, 2, "Unknown window");
+      return;
+    }
+    auto& w = it->second;
+    if (r.type == 0x401) {
+      w.closing = true;
+      Publish(w);
+      auto* browser = w.browser.get();
+      send_.Run(7, r.id, {});
+      browser->GetWindow()->Close();
+      return;
+    }
+    input_ = id;
+    Reconcile();
+    send_.Run(0x480, r.id, Snapshot(w));
+  }
+
+ private:
+  PrtsTargetRegistry::SendCallback send_;
+  uint64_t next_ = 0, input_ = 0;
+  bool pending_ = false, mutating_ = false;
+  std::map<uint64_t, Window> windows_;
+  std::map<uint64_t, std::unique_ptr<Tab>> tabs_;
+  std::map<uint64_t, std::vector<uint8_t>> snapshots_;
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      observation_{this};
+  base::WeakPtrFactory<Impl> weak_{this};
+};
+PrtsWindowRegistry::PrtsWindowRegistry(PrtsTargetRegistry::SendCallback send)
+    : impl_(std::make_unique<Impl>(std::move(send))) {}
+PrtsWindowRegistry::~PrtsWindowRegistry() = default;
+void PrtsWindowRegistry::Start() {
+  impl_->Start();
+}
+void PrtsWindowRegistry::Handle(const prts::Record& record) {
+  impl_->Handle(record);
+}
