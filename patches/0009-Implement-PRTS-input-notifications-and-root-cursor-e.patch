+  void Cursor(content::RenderWidgetHost* host, const ui::Cursor& cursor) {
+    auto it = targets_.find(active_);
+    if (it == targets_.end()) {
+      return;
+    }
+    auto& target = *it->second;
+    if (!target.announced ||
+        target.web_contents()->GetPrimaryMainFrame()->GetRenderWidgetHost() !=
+            host) {
+      return;
+    }
+    uint8_t shape = 0;
+    using C = ui::mojom::CursorType;
+    switch (cursor.type()) {
+      case C::kHand:
+        shape = 1;
+        break;
+      case C::kIBeam:
+        shape = 2;
+        break;
+      case C::kCross:
+        shape = 3;
+        break;
+      case C::kMove:
+        shape = 4;
+        break;
+      case C::kEastResize:
+      case C::kWestResize:
+      case C::kEastWestResize:
+        shape = 5;
+        break;
+      case C::kNorthResize:
+      case C::kSouthResize:
+      case C::kNorthSouthResize:
+        shape = 6;
+        break;
+      case C::kNone:
+        shape = 7;
+        break;
+      default:
+        break;  // Custom cursor feature is not advertised: use default.
+    }
+    prts::Encoder e;
+    e.Int(target.id, 8);
+    e.Int(target.generation, 8);
+    e.Int(shape, 1);
+    for (int i = 0; i < 5; ++i) {
+      e.Int(0, 4);
+    }
+    send_.Run(0x193, 0, std::move(e.data));
+  }
+  void InputFailed() {
+    prts::Encoder e;
+    e.Int(7, 4);
+    e.String("Input renderer acknowledgement timed out");
+    e.Int(1, 1);
+    send_.Run(8, 0, std::move(e.data));
+  }
+  void Input(uint16_t type, const std::vector<uint8_t>& bytes) {
+    prts::Decoder d(bytes);
+    auto id = d.Int(8), generation = d.Int(8), sequence = d.Int(8),
+         modifiers = d.Int(4);
+    auto fault = [&](uint32_t code) {
