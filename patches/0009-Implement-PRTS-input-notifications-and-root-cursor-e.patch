diff --git a/chrome/browser/prts/prts_input.cc b/chrome/browser/prts/prts_input.cc
new file mode 100644
index 0000000000..52caae135d
--- /dev/null
+++ b/chrome/browser/prts/prts_input.cc
@@ -0,0 +1,358 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/prts/prts_input.h"
+
+#include <array>
+#include <bit>
+#include <cmath>
+#include <limits>
+#include <map>
+
+#include "base/containers/circular_deque.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/timer/timer.h"
+#include "components/input/native_web_keyboard_event.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/synthetic_input.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "third_party/blink/public/common/input/web_mouse_wheel_event.h"
+#include "third_party/blink/public/common/page/page_zoom.h"
+#include "ui/events/keycodes/dom/dom_code.h"
+#include "ui/events/keycodes/dom/dom_key.h"
+#include "ui/events/keycodes/dom/keycode_converter.h"
+#include "ui/latency/latency_info.h"
+namespace prts {
+namespace {
+using E = blink::WebInputEvent;
+int Modifiers(uint32_t m, uint32_t buttons) {
+  int out = 0;
+  const std::array flags = {E::kShiftKey, E::kControlKey, E::kAltKey,
+                            E::kMetaKey,  E::kCapsLockOn, E::kNumLockOn};
+  for (int i = 0; i < 6; ++i) {
+    if (m & (1u << i)) {
+      out |= flags[i];
+    }
+  }
+  const std::array mouse = {E::kLeftButtonDown, E::kRightButtonDown,
+                            E::kMiddleButtonDown, E::kBackButtonDown,
+                            E::kForwardButtonDown};
+  for (int i = 0; i < 5; ++i) {
+    if (buttons & (1u << i)) {
+      out |= mouse[i];
+    }
+  }
+  return out;
+}
+bool Text(const std::string& s) {
+  return s.size() <= 4096 && s.find('\0') == std::string::npos;
+}
+}  // namespace
+class PrtsInput::Impl : public content::WebContentsObserver {
+ public:
+  Impl(content::WebContents* contents, base::RepeatingClosure failed)
+      : WebContentsObserver(contents), failed_(std::move(failed)) {}
+  content::RenderWidgetHost* Root() {
+    return web_contents()
+               ? web_contents()->GetPrimaryMainFrame()->GetRenderWidgetHost()
+               : nullptr;
+  }
+  content::RenderWidgetHost* Focused() {
+    return content::FocusedSyntheticInputWidget(web_contents());
+  }
+
+  void Done() {
+    deadline_.Stop();
+    busy_ = false;
+    RunNext();
+  }
+  void RunNext() {
+    if (busy_ || queue_.empty()) {
+      return;
+    }
+    busy_ = true;
+    deadline_.Start(FROM_HERE, base::Seconds(5), failed_);
+    auto action = std::move(queue_.front());
+    queue_.pop_front();
+    std::move(action).Run();
+  }
+  void Enqueue(base::OnceClosure action) {
+    queue_.push_back(std::move(action));
+    RunNext();
+  }
+  base::OnceClosure Completion() {
+    return base::BindOnce(&Impl::Done, weak_.GetWeakPtr());
+  }
+  void Reset() {
+    deadline_.Stop();
+    weak_.InvalidateWeakPtrs();
+    queue_.clear();
+    busy_ = false;
+    ReleaseState();
+  }
+  void ReleaseState() {
+    auto keys = std::move(keys_);
+    keys_.clear();
+    if (auto* host = Focused()) {
+      for (auto& [vk, event] : keys) {
+        event.SetType(E::Type::kKeyUp);
+        event.SetModifiers(0);
+        host->ForwardKeyboardEvent(event);
+      }
+    }
+    if (auto* root = Root()) {
+      if (buttons_ && root->GetView()) {
+        for (int b = 1; b <= 5; ++b) {
+          const uint32_t bit = 1u << (b == 2 ? 2 : b == 3 ? 1 : b - 1);
+          if (!(buttons_ & bit)) {
+            continue;
+          }
+          buttons_ &= ~bit;
+          blink::WebMouseEvent event(E::Type::kMouseUp, Modifiers(0, buttons_),
+                                     base::TimeTicks::Now());
+          event.button = static_cast<blink::WebMouseEvent::Button>(b - 1);
+          event.click_count = 1;
+          event.SetPositionInWidget(point_);
+          content::RouteSyntheticMouse(web_contents(), event);
+        }
+      }
+      content::SetSyntheticPageFocus(web_contents(), false);
+    }
+    buttons_ = 0;
+  }
+  void DidFinishNavigation(content::NavigationHandle* nav) override {
+    if (nav->IsInPrimaryMainFrame() && nav->HasCommitted() &&
+        !nav->IsSameDocument()) {
+      Reset();
+    }
+  }
+  uint32_t Dispatch(uint16_t type, Decoder& d, uint32_t mods) {
+    if (queue_.size() >= 1024) {
+      return 5;
+    }
+    auto* root = Root();
+    if (type <= 0x203) {
+      const double x = std::bit_cast<double>(d.Int(8)),
+                   y = std::bit_cast<double>(d.Int(8));
+      double dx = 0, dy = 0;
+      uint64_t button = 0, buttons = 0, count = 0;
+      if (type == 0x203) {
+        dx = std::bit_cast<double>(d.Int(8));
+        dy = std::bit_cast<double>(d.Int(8));
+      }
+      if (type == 0x201 || type == 0x202) {
+        button = d.Int(1);
+      }
+      buttons = d.Int(4);
+      if (type == 0x201 || type == 0x202) {
+        count = d.Int(1);
+      }
+      if (!d.Done() || !std::isfinite(x) || !std::isfinite(y) ||
+          !std::isfinite(dx) || !std::isfinite(dy) ||
+          std::abs(x) > std::numeric_limits<float>::max() ||
+          std::abs(y) > std::numeric_limits<float>::max() ||
+          std::abs(dx) > std::numeric_limits<float>::max() ||
+          std::abs(dy) > std::numeric_limits<float>::max() || buttons > 31 ||
+          ((type == 0x201 || type == 0x202) &&
+           (button < 1 || button > 5 || count < 1 || count > 3))) {
+        return 1;
+      }
+      if (button) {
+        const uint32_t bit = 1u << (button == 2   ? 2
+                                    : button == 3 ? 1
+                                                  : button - 1);
+        if ((type == 0x201 && !(buttons & bit)) ||
+            (type == 0x202 && (buttons & bit))) {
+          return 1;
+        }
+      }
+      if (!root || !root->GetView()) {
+        return 0;
+      }
+
+      // Router coordinates are DIPs. Device emulation applies DPR in the
+      // renderer/compositor; multiplying by DPR here would apply it twice.
+      const float scale = content::SyntheticInputScale(web_contents());
+      const gfx::PointF point(x * scale, y * scale);
+      if (!std::isfinite(point.x()) || !std::isfinite(point.y())) {
+        return 1;
+      }
+
+      if (type == 0x203) {
+        blink::WebMouseWheelEvent event(E::Type::kMouseWheel,
+                                        Modifiers(mods, buttons),
+                                        base::TimeTicks::Now());
+        event.SetPositionInWidget(point);
+        event.delta_x = -dx;
+        event.delta_y = -dy;
+        event.wheel_ticks_x = dx == 0 ? 0 : dx > 0 ? -1 : 1;
+        event.wheel_ticks_y = dy == 0 ? 0 : dy > 0 ? -1 : 1;
+        event.delta_units = ui::ScrollGranularity::kScrollByPrecisePixel;
+        event.phase = blink::WebMouseWheelEvent::kPhaseBegan;
+        Enqueue(
+            base::BindOnce(&Impl::StartWheel, base::Unretained(this), event));
+      } else {
+        const auto kind = type == 0x200   ? E::Type::kMouseMove
+                          : type == 0x201 ? E::Type::kMouseDown
+                                          : E::Type::kMouseUp;
+        blink::WebMouseEvent event(kind, Modifiers(mods, buttons),
+                                   base::TimeTicks::Now());
+        event.SetPositionInWidget(point);
+        event.button =
+            button ? static_cast<blink::WebMouseEvent::Button>(button - 1)
+                   : blink::WebMouseEvent::Button::kNoButton;
+        event.click_count = count;
+        Enqueue(base::BindOnce(&Impl::Mouse, base::Unretained(this), event,
+                               static_cast<uint32_t>(buttons)));
+      }
+      return 0;
+    }
+    if (type == 0x207) {
+      auto focused = d.Int(1);
+      if (!d.Done() || focused > 1) {
+        return 1;
+      }
+      Enqueue(
+          base::BindOnce(&Impl::Focus, base::Unretained(this), focused != 0));
+      return 0;
+    }
+    if (type == 0x206) {
+      auto text = d.String();
+      if (!d.Done() || !Text(text)) {
+        return 1;
+      }
+      auto utf16 = base::UTF8ToUTF16(text);
+      auto* host = Focused();
+      if (!host) {
+        return 0;
+      }
+      // Character events preserve keypress for ordinary typing; longer/IME
+      // commits use Input.insertText's single text commit primitive.
+      if (utf16.empty()) {
+        return 0;
+      }
+      if (utf16.size() == 1) {
+        input::NativeWebKeyboardEvent event(E::Type::kChar, Modifiers(mods, 0),
+                                            base::TimeTicks::Now());
+        if (!utf16.empty()) {
+          event.text[0] = event.unmodified_text[0] = utf16[0];
+        }
+        event.skip_if_unhandled = true;
+        Enqueue(base::BindOnce(&Impl::Key, base::Unretained(this), event));
+      } else {
+        Enqueue(base::BindOnce(&Impl::Commit, base::Unretained(this), utf16));
+      }
+      return 0;
+    }
+    auto vk = d.Int(4);
+    auto code = d.String();
+    auto key = d.String();
+    auto text = d.String();
+    auto location = d.Int(1), repeat = d.Int(1), system = d.Int(1);
+    const auto dom_code = ui::KeycodeConverter::CodeStringToDomCode(code);
+    const auto dom_key = ui::KeycodeConverter::KeyStringToDomKey(key);
+    if (!d.Done() || vk > 255 || location > 3 || repeat > 1 || system > 1 ||
+        !Text(text) || code.find('\0') != std::string::npos ||
+        key.find('\0') != std::string::npos ||
+        (code.empty() && key != "Unidentified") ||
+        (!code.empty() && dom_code == ui::DomCode::NONE) ||
+        dom_key == ui::DomKey::NONE ||
+        (type == 0x205 && (!text.empty() || repeat))) {
+      return 1;
+    }
+    int modifiers = Modifiers(mods, 0);
+    if (repeat) {
+      modifiers |= E::kIsAutoRepeat;
+    }
+    if (location == 1) {
+      modifiers |= E::kIsLeft;
+    }
+    if (location == 2) {
+      modifiers |= E::kIsRight;
+    }
+    if (location == 3) {
+      modifiers |= E::kIsKeyPad;
+    }
+    input::NativeWebKeyboardEvent event(
+        type == 0x204 ? E::Type::kRawKeyDown : E::Type::kKeyUp, modifiers,
+        base::TimeTicks::Now());
+    event.windows_key_code = vk;
+    event.dom_code = static_cast<int>(dom_code);
+    event.dom_key = static_cast<int>(dom_key);
+    event.is_system_key = system;
+    event.skip_if_unhandled = true;
+    Enqueue(base::BindOnce(&Impl::Key, base::Unretained(this), event));
+    return 0;
+  }
+  void Focus(bool focused) {
+    if (!focused) {
+      ReleaseState();
+    } else {
+      content::SetSyntheticPageFocus(web_contents(), true);
+    }
+    Done();
+  }
+  void Mouse(blink::WebMouseEvent event, uint32_t buttons) {
+    buttons_ = buttons;
+    point_ = event.PositionInWidget();
+    content::SetSyntheticPageFocus(web_contents(), true);
+    content::RouteSyntheticMouse(web_contents(), event, Completion());
+  }
+  void Key(input::NativeWebKeyboardEvent event) {
+    if (event.GetType() == E::Type::kRawKeyDown) {
+      keys_.insert_or_assign(event.windows_key_code, event);
+    } else if (event.GetType() == E::Type::kKeyUp) {
+      keys_.erase(event.windows_key_code);
+    }
+    content::DispatchSyntheticKey(web_contents(), event, Completion());
+  }
+  void Commit(std::u16string text) {
+    if (auto* host = Focused()) {
+      host->Focus();
+      content::CommitSyntheticText(host, text, Completion());
+    } else {
+      Done();
+    }
+  }
+  void StartWheel(blink::WebMouseWheelEvent event) {
+    if (auto* root = Root()) {
+      root->InsertVisualStateCallback(
+          base::BindOnce(&Impl::Wheel, weak_.GetWeakPtr(), event));
+    } else {
+      Done();
+    }
+  }
+  void Wheel(blink::WebMouseWheelEvent event, bool success) {
+    if (!success || !Root()) {
+      Done();
+      return;
+    }
+    content::SetSyntheticPageFocus(web_contents(), true);
+    content::RouteSyntheticWheel(web_contents(), event, Completion());
+  }
+
+ private:
+  base::RepeatingClosure failed_;
+  base::OneShotTimer deadline_;
+  bool busy_ = false;
+  base::circular_deque<base::OnceClosure> queue_;
+  uint32_t buttons_ = 0;
+  gfx::PointF point_;
+  std::map<uint32_t, input::NativeWebKeyboardEvent> keys_;
+  base::WeakPtrFactory<Impl> weak_{this};
+};
+PrtsInput::PrtsInput(content::WebContents* c, base::RepeatingClosure failed)
+    : impl_(std::make_unique<Impl>(c, std::move(failed))) {}
+PrtsInput::~PrtsInput() = default;
+uint32_t PrtsInput::Dispatch(uint16_t t, Decoder& d, uint32_t m) {
+  return impl_->Dispatch(t, d, m);
+}
+void PrtsInput::Reset() {
+  impl_->Reset();
+}
+}  // namespace prts
