From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Wed, 21 Oct 2026 11:23:31 +0800
Subject: [PATCH 31/31] Use a build guard for the Windows headless UA product
 override

Avoid Chromium unreachable-code diagnostics from a constant-false runtime branch; web identity behavior is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/components/embedder_support/user_agent_utils.cc b/components/embedder_support/user_agent_utils.cc
index a50c033f88..046bec0c32 100644
--- a/components/embedder_support/user_agent_utils.cc
+++ b/components/embedder_support/user_agent_utils.cc
@@ -450,10 +450,11 @@ std::string BuildUserAgentFromProduct(const std::string& product) {
 // depending on the Reduce User-Agent reduction phase features.
 std::string GetUserAgentInternal() {
   std::string product = GetProductAndVersion();
-  if (!BUILDFLAG(IS_WIN) &&
-      base::CommandLine::ForCurrentProcess()->HasSwitch(kHeadless)) {
+#if !BUILDFLAG(IS_WIN)
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(kHeadless)) {
     product.insert(0, "Headless");
   }
+#endif
 
 #if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_IOS)
   if (base::CommandLine::ForCurrentProcess()->HasSwitch(kUseMobileUserAgent)) {
