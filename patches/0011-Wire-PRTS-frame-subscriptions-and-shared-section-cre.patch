diff --git a/chrome/browser/prts/prts_controller.cc b/chrome/browser/prts/prts_controller.cc
index 9f570d25bf..dd281c2eed 100644
--- a/chrome/browser/prts/prts_controller.cc
+++ b/chrome/browser/prts/prts_controller.cc
@@ -130,6 +130,13 @@ void PrtsController::Receive(Record record) {
     targets_->Input(record.type, record.payload);
     return;
   }
+  if (ready_ &&
+      ((record.type == 7 && !(record.id & 1)) || record.type == 0x320)) {
+    if (!targets_->Frame(record)) {
+      Failed();
+    }
+    return;
+  }
   if (!record.id || !(record.id & 1) || record.id <= last_request_) {
     Failed();
     return;
@@ -193,6 +200,7 @@ void PrtsController::Receive(Record record) {
       Failed();
       return;
     }
+    targets_->SetFrameLimit(inflight);
     ready_ = true;
     return;
   }
@@ -229,8 +237,10 @@ void PrtsController::Receive(Record record) {
       stopping_ = false;
       Failed();
     }
-  } else if (record.type == 0x321) {
-    Error(record.id, 3, "Frame production is unavailable in M1");
+  } else if (record.type == 0x321 || record.type == 0x322) {
+    if (!targets_->Frame(record)) {
+      Failed();
+    }
   } else {
     // A response on the command pipe, unknown type, or notification with a
     // request ID is a direction/type violation, never stream resync.
diff --git a/chrome/browser/prts/prts_pipe_client_win.cc b/chrome/browser/prts/prts_pipe_client_win.cc
index fb3c6d2d10..2d0ac9201a 100644
--- a/chrome/browser/prts/prts_pipe_client_win.cc
+++ b/chrome/browser/prts/prts_pipe_client_win.cc
@@ -110,6 +110,7 @@ struct PrtsPipeClient::State {
   struct Pending {
     std::vector<uint8_t> bytes;
     base::OnceClosure written;
+    size_t channel = 1;
   };
   State()
       : wake(base::WaitableEvent::ResetPolicy::AUTOMATIC),
@@ -199,7 +200,7 @@ struct PrtsPipeClient::State {
           pending = std::move(self->outgoing.front());
           self->outgoing.pop_front();
         }
-        if (!Transfer(self->handles[1].get(), pending.bytes, true,
+        if (!Transfer(self->handles[pending.channel].get(), pending.bytes, true,
                       self->stopped)) {
           if (!self->stopped.load()) {
             self->Fail();
@@ -270,7 +271,8 @@ bool PrtsPipeClient::Send(uint16_t type,
       state_->oldest_write = base::TimeTicks::Now();
     }
     state_->outgoing_bytes += bytes.size();
-    state_->outgoing.push_back({std::move(bytes), std::move(written)});
+    state_->outgoing.push_back({std::move(bytes), std::move(written),
+                                type == 0x310 || type == 0x311 ? 2u : 1u});
   }
   state_->wake.Signal();
   return true;
diff --git a/chrome/browser/prts/prts_target_registry.cc b/chrome/browser/prts/prts_target_registry.cc
index 382a63863e..672859e1c6 100644
--- a/chrome/browser/prts/prts_target_registry.cc
+++ b/chrome/browser/prts/prts_target_registry.cc
@@ -24,6 +24,7 @@
 #include "chrome/browser/profiles/keep_alive/scoped_profile_keep_alive.h"
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/prts/prts_capture.h"
 #include "chrome/browser/prts/prts_input.h"
 #include "chrome/browser/ui/browser_window/public/browser_collection_observer.h"
 #include "chrome/browser/ui/browser_window/public/create_browser_window.h"
@@ -120,7 +121,7 @@ void PutString(std::vector<uint8_t>& bytes, const std::string& value) {
 class PrtsTargetRegistry::Impl : public BrowserCollectionObserver,
                                  public TabStripModelObserver {
  public:
-  explicit Impl(SendCallback send) : send_(std::move(send)) {}
+  explicit Impl(SendCallback send) : send_(std::move(send)), capture_(send_) {}
   ~Impl() override { Stop(); }
 
   class StartupContents : public content::WebContentsObserver {
@@ -407,6 +408,9 @@ class PrtsTargetRegistry::Impl : public BrowserCollectionObserver,
     }
     strips_.clear();
     ignored_.clear();
+    for (auto& [id, target] : targets_) {
+      capture_.Remove(id);
+    }
     targets_.clear();
     GlobalBrowserCollection::GetInstance()->ForEach(
         [](BrowserWindowInterface* browser) {
@@ -435,6 +439,8 @@ class PrtsTargetRegistry::Impl : public BrowserCollectionObserver,
   }
 
   void Changed(Target& target) {
+    capture_.Update(target.web_contents(), target.id, target.generation,
+                    DeviceSize(target));
     if (started_ && target.announced) {
       send_.Run(0x0192, 0, Snapshot(target));
     }
@@ -490,6 +496,7 @@ class PrtsTargetRegistry::Impl : public BrowserCollectionObserver,
   }
 
   void Destroyed(uint64_t id) {
+    capture_.Remove(id);
     auto found = targets_.find(id);
     if (found == targets_.end()) {
       return;
@@ -741,8 +748,59 @@ class PrtsTargetRegistry::Impl : public BrowserCollectionObserver,
     send_.Run(0x0180, request, Snapshot(target));
   }
 
+ public:
+  void SetFrameLimit(uint32_t limit) {
+    frame_limit_ = std::min(2u, limit);
+    capture_.SetLimit(frame_limit_);
+  }
+  static gfx::Size DeviceSize(const Target& t) {
+    return gfx::Size(std::ceil(t.size.width * t.size.dpr),
+                     std::ceil(t.size.height * t.size.dpr));
+  }
+  bool Frame(const prts::Record& r) {
+    if (r.type != 0x321 && r.type != 0x322) {
+      return capture_.Receive(r);
+    }
+    prts::Decoder d(r.payload);
+    auto id = d.Int(8);
+    auto it = targets_.find(id);
+    if (it == targets_.end()) {
+      Error(r.id, 2, "Unknown frame target");
+      return true;
+    }
+    auto& t = *it->second;
+    if (r.type == 0x322) {
+      if (!d.Done()) {
+        return false;
+      }
+      capture_.Refresh(id);
+      send_.Run(7, r.id, {});
+      return true;
+    }
+    auto mode = d.Int(1), limit = d.Int(4), fps = d.Int(4);
+    if (!d.Done() || (mode != 0 && mode != 2) ||
+        (mode == 2 && (!limit || limit > frame_limit_ || !fps || fps > 120)) ||
+        (mode == 0 && (limit || fps))) {
+      Error(r.id, 1, "Invalid CPU fallback configuration");
+      return true;
+    }
+    if (mode && !capture_.CanSubscribe(id)) {
+      Error(r.id, 5, "CPU fallback supports at most two subscriptions");
+      return true;
+    }
+    t.input->Reset();
+    ++t.generation;
+    capture_.Configure(t.web_contents(), id, t.generation, DeviceSize(t),
+                       mode ? fps : 0);
+    Changed(t);
+    send_.Run(0x180, r.id, Snapshot(t));
+    return true;
+  }
+
  private:
   SendCallback send_;
+  prts::PrtsCapture capture_;
+  uint32_t frame_limit_ = 2;
   base::CallbackListSubscription cursor_subscription_;
   uint64_t input_sequence_ = 0;
   base::TimeTicks last_stale_;
@@ -783,3 +841,10 @@ void PrtsTargetRegistry::Input(uint16_t type,
                                const std::vector<uint8_t>& bytes) {
   impl_->Input(type, bytes);
 }
+
+bool PrtsTargetRegistry::Frame(const prts::Record& r) {
+  return impl_->Frame(r);
+}
+void PrtsTargetRegistry::SetFrameLimit(uint32_t limit) {
+  impl_->SetFrameLimit(limit);
+}
