+  void Fault(uint32_t code) {
+    prts::Encoder e;
+    e.Int(code, 4);
+    e.String(code == 10  ? "Stale window input"
+             : code == 7 ? "Aura input completion timed out"
+             : code == 4 ? "Focused input client unavailable"
+                         : "Invalid window input");
+    e.Int(0, 1);
+    send_.Run(8, 0, std::move(e.data));
+  }
+  content::WebContents* Contents(uint64_t id) {
+    auto it = windows_.find(id);
+    return it == windows_.end()
+               ? nullptr
+               : it->second.browser->GetTabStripModel()->GetActiveWebContents();
+  }
+  void EnsureInput(Window& w) {
+    if (!w.input && Root(w)) {
