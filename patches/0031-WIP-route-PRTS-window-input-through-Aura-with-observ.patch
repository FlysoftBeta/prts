+#include "content/public/browser/aura_input_barrier.h"
+
+#include <map>
+#include <set>
+
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/timer/timer.h"
+#include "components/input/render_widget_host_input_event_router.h"
+#include "content/browser/renderer_host/render_widget_host_impl.h"
+#include "content/browser/renderer_host/render_widget_host_view_aura.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host_observer.h"
+#include "content/public/browser/synthetic_input.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+
+namespace content {
+namespace {
+class AuraBarrier final : public WebContentsObserver,
+                          public RenderWidgetHost::InputEventObserver,
+                          public RenderWidgetHostObserver {
+ public:
+  AuraBarrier(WebContents* contents,
+              base::TimeTicks stamp,
+              base::OnceCallback<void(bool)> done)
+      : WebContentsObserver(contents), stamp_(stamp), done_(std::move(done)) {
+    contents->ForEachRenderFrameHost([&](RenderFrameHost* frame) {
+      auto* host = frame->GetRenderWidgetHost();
+      if (hosts_.insert(host).second) {
+        host->AddInputEventObserver(this);
+        host->AddObserver(this);
+      }
+    });
+    timeout_.Start(
+        FROM_HERE, base::Seconds(5),
+        base::BindOnce(&AuraBarrier::Finish, weak_.GetWeakPtr(), false));
+  }
+  ~AuraBarrier() override {
+    for (auto* host : hosts_) {
+      host->RemoveInputEventObserver(this);
+      host->RemoveObserver(this);
+    }
+  }
+  void Begin(base::OnceClosure dispatch) {
+    auto weak = weak_.GetWeakPtr();
+    std::move(dispatch).Run();
+    if (weak) {
+      PostPoll();
+    }
+  }
+  void OnInputEvent(const RenderWidgetHost& host,
+                    const blink::WebInputEvent& event,
+                    InputEventSource) override {
+    if (event.TimeStamp() == stamp_) {
+      saw_dispatch_ = true;
+      ++pending_[{&host, event.GetType()}];
+    }
+  }
+  void OnInputEventAck(const RenderWidgetHost& host,
+                       blink::mojom::InputEventResultSource,
+                       blink::mojom::InputEventResultState,
+                       const blink::WebInputEvent& event) override {
+    if (event.TimeStamp() != stamp_) {
+      return;
+    }
+    auto it = pending_.find({&host, event.GetType()});
+    if (it != pending_.end() && --it->second == 0) {
+      pending_.erase(it);
+    }
+  }
+  void RenderWidgetHostDestroyed(RenderWidgetHost* host) override {
+    host->RemoveInputEventObserver(this);
+    host->RemoveObserver(this);
+    hosts_.erase(host);
+    std::erase_if(pending_, [host](const auto& entry) {
+      return entry.first.first == host;
+    });
+  }
+  void WebContentsDestroyed() override { Finish(false); }
+  void PostPoll() {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce(&AuraBarrier::Poll, weak_.GetWeakPtr()),
+        base::Milliseconds(1));
+  }
+  void Poll() {
+    if (!web_contents()) {
+      Finish(false);
+      return;
+    }
+    auto* root = RenderWidgetHostImpl::From(
+        web_contents()->GetPrimaryMainFrame()->GetRenderWidgetHost());
+    // The router's production pending-dispatch predicate includes asynchronous
+    // targeting; an empty ACK observer set alone is not completion.
+    if (!pending_.empty() ||
+        (root->GetInputEventRouter() &&
+         root->GetInputEventRouter()->HasEventsPendingDispatch())) {
+      PostPoll();
+      return;
+    }
+    if (!saw_dispatch_) {
+      Finish(true);
+      return;
+    }  // Views consumed / target lost.
+    auto* focused =
+        RenderWidgetHostImpl::From(FocusedSyntheticInputWidget(web_contents()));
+    if (!focused) {
+      Finish(false);
+      return;
+    }
+    focused->WaitForInputProcessed(
+        base::BindOnce(&AuraBarrier::Processed, weak_.GetWeakPtr()));
+  }
+  void Processed() {
+    if (!web_contents()) {
+      Finish(false);
+      return;
+    }
+    auto* root = web_contents()->GetPrimaryMainFrame()->GetRenderWidgetHost();
+    root->InsertVisualStateCallback(
+        base::BindOnce(&AuraBarrier::Finish, weak_.GetWeakPtr()));
+  }
+  void Finish(bool success) {
+    timeout_.Stop();
+    if (done_) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(std::move(done_), success));
+    }
+    delete this;
+  }
+
+ private:
+  const base::TimeTicks stamp_;
+  base::OnceCallback<void(bool)> done_;
+  std::set<RenderWidgetHost*> hosts_;
+  std::map<std::pair<const RenderWidgetHost*, blink::WebInputEvent::Type>,
+           size_t>
+      pending_;
+  bool saw_dispatch_ = false;
+  base::OneShotTimer timeout_;
+  base::WeakPtrFactory<AuraBarrier> weak_{this};
+};
+}  // namespace
+void DispatchWithAuraInputBarrier(WebContents* contents,
+                                  base::TimeTicks stamp,
+                                  base::OnceClosure dispatch,
+                                  base::OnceCallback<void(bool)> done) {
+  if (!contents) {
+    std::move(dispatch).Run();
+    std::move(done).Run(true);
+    return;
+  }
+  (new AuraBarrier(contents, stamp, std::move(done)))
+      ->Begin(std::move(dispatch));
+}
+bool IsAuraContentTextClient(WebContents* contents,
+                             const ui::TextInputClient* client) {
+  auto* view = contents ? contents->GetRenderWidgetHostView() : nullptr;
+  return view && static_cast<const ui::TextInputClient*>(
+                     static_cast<RenderWidgetHostViewAura*>(view)) == client;
+}
+void FinishAuraTextCommit(WebContents* contents, base::OnceClosure done) {
+  auto* focused =
+      RenderWidgetHostImpl::From(FocusedSyntheticInputWidget(contents));
+  if (focused) {
+    focused->WaitForInputProcessed(std::move(done));
+  } else {
+    std::move(done).Run();
+  }
+}
+}  // namespace content
