@@ -0,0 +1,431 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/prts/prts_window_input.h"
+
+#include <array>
+#include <bit>
+#include <cmath>
+#include <map>
+
+#include "base/containers/circular_deque.h"
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/timer/timer.h"
+#include "content/public/browser/aura_input_barrier.h"
+#include "ui/aura/client/capture_client.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_observer.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/base/ime/input_method.h"
+#include "ui/base/ime/text_input_client.h"
+#include "ui/display/win/screen_win_headless.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/dom/dom_code.h"
+#include "ui/events/keycodes/dom/dom_key.h"
+#include "ui/events/keycodes/dom/keycode_converter.h"
+#include "ui/gfx/geometry/point_conversions.h"
+#include "ui/views/widget/desktop_aura/desktop_capture_client.h"
+#include "ui/views/widget/widget.h"
+
+namespace prts {
+namespace {
+int Flags(uint32_t modifiers, uint32_t buttons) {
+  int flags = 0;
+  const std::array mods = {ui::EF_SHIFT_DOWN,   ui::EF_CONTROL_DOWN,
+                           ui::EF_ALT_DOWN,     ui::EF_COMMAND_DOWN,
+                           ui::EF_CAPS_LOCK_ON, ui::EF_NUM_LOCK_ON};
+  const std::array mouse = {ui::EF_LEFT_MOUSE_BUTTON, ui::EF_RIGHT_MOUSE_BUTTON,
+                            ui::EF_MIDDLE_MOUSE_BUTTON,
+                            ui::EF_BACK_MOUSE_BUTTON,
+                            ui::EF_FORWARD_MOUSE_BUTTON};
+  for (int i = 0; i < 6; ++i) {
+    if (modifiers & (1u << i)) {
+      flags |= mods[i];
+    }
+  }
+  for (int i = 0; i < 5; ++i) {
+    if (buttons & (1u << i)) {
+      flags |= mouse[i];
+    }
+  }
+  return flags;
+}
+int Button(uint64_t b) {
+  return b == 1   ? ui::EF_LEFT_MOUSE_BUTTON
+         : b == 2 ? ui::EF_MIDDLE_MOUSE_BUTTON
+         : b == 3 ? ui::EF_RIGHT_MOUSE_BUTTON
+         : b == 4 ? ui::EF_BACK_MOUSE_BUTTON
+                  : ui::EF_FORWARD_MOUSE_BUTTON;
+}
+bool TextValid(const std::string& text) {
+  return text.size() <= 4096 && text.find('\0') == std::string::npos;
+}
+}  // namespace
+class PrtsWindowInput::Impl : public aura::WindowObserver {
+ public:
+  Impl(aura::Window* root,
+       base::RepeatingCallback<content::WebContents*()> contents,
+       base::RepeatingCallback<void(uint32_t)> fault)
+      : root_(root), contents_(std::move(contents)), fault_(std::move(fault)) {
+    root_->AddObserver(this);
+  }
+  ~Impl() override {
+    Reset();
+    if (root_) {
+      root_->RemoveObserver(this);
+    }
+  }
+  void OnWindowDestroying(aura::Window* window) override {
+    Reset();
+    root_->RemoveObserver(this);
+    root_ = nullptr;
+  }
+  views::Widget* Widget() {
+    if (root_) {
+      for (auto* child : root_->children()) {
+        if (auto* widget = views::Widget::GetWidgetForNativeWindow(child)) {
+          return widget;
+        }
+      }
+    }
+    return nullptr;
+  }
+  base::TimeTicks Stamp() {
+    auto now = base::TimeTicks::Now();
+    last_stamp_ = std::max(now, last_stamp_ + base::Microseconds(1));
+    return last_stamp_;
+  }
+  ui::TextInputClient* Client() {
+    return root_ && root_->GetHost()->GetInputMethod()
+               ? root_->GetHost()->GetInputMethod()->GetTextInputClient()
+               : nullptr;
+  }
+  void Done(bool success = true) {
+    deadline_.Stop();
+    busy_ = false;
+    if (!success) {
+      fault_.Run(7);
+      Reset();
+      return;
+    }
+    Next();
+  }
+  void Next() {
+    if (busy_ || queue_.empty() || !root_) {
+      return;
+    }
+    busy_ = true;
+    deadline_.Start(FROM_HERE, base::Seconds(5),
+                    base::BindOnce(&Impl::Done, weak_.GetWeakPtr(), false));
+    auto action = std::move(queue_.front());
+    queue_.pop_front();
+    std::move(action).Run();
+  }
+  void Enqueue(base::OnceClosure action) {
+    queue_.push_back(std::move(action));
+    Next();
+  }
+  void Send(std::unique_ptr<ui::Event> event,
+            base::OnceCallback<void(bool)> done) {
+    if (!root_) {
+      std::move(done).Run(false);
+      return;
+    }
+    auto stamp = event->time_stamp();
+    content::DispatchWithAuraInputBarrier(
+        contents_.Run(), stamp,
+        base::BindOnce(&Impl::SendNow, weak_.GetWeakPtr(), std::move(event)),
+        std::move(done));
+  }
+  void SendNow(std::unique_ptr<ui::Event> event) {
+    if (!root_) {
+      return;
+    }
+    root_->GetHost()->SendEventToSink(event.get());
+  }
+  void Reset() {
+    weak_.InvalidateWeakPtrs();
+    deadline_.Stop();
+    queue_.clear();
+    busy_ = false;
+    if (!root_) {
+      return;
+    }
+    auto* host = root_->GetHost();
+    for (const auto& [vk, key] : keys_) {
+      ui::KeyEvent release(ui::EventType::kKeyReleased, key.key_code(),
+                           key.code(), ui::EF_IS_SYNTHESIZED, key.GetDomKey(),
+                           Stamp());
+      host->SendEventToSink(&release);
+    }
+    keys_.clear();
+    for (uint32_t bit = 1; bit <= 16; bit <<= 1) {
+      if (buttons_ & bit) {
+        buttons_ &= ~bit;
+        gfx::PointF point = point_;
+        host->ConvertDIPToPixels(&point);
+        ui::MouseEvent up(ui::EventType::kMouseReleased, point, point, Stamp(),
+                          Flags(0, buttons_), Flags(0, bit));
+        host->SendEventToSink(&up);
+      }
+    }
+    if (auto* capture = views::DesktopCaptureClient::GetCaptureWindowGlobal();
+        capture && capture->GetRootWindow() == root_) {
+      capture->ReleaseCapture();
+    }
+    if (hover_) {
+      gfx::PointF point = point_;
+      host->ConvertDIPToPixels(&point);
+      ui::MouseEvent exit(ui::EventType::kMouseExited, point, point, Stamp(), 0,
+                          0);
+      host->SendEventToSink(&exit);
+    }
+    hover_ = false;
+    wheel_x_ = wheel_y_ = 0;
+  }
+  uint32_t Dispatch(uint16_t type, Decoder& d, uint32_t modifiers) {
+    if (!root_) {
+      return 4;
+    }
+    if (queue_.size() >= 1024) {
+      return 5;
+    }
+    if (type <= 0x203) {
+      double x = std::bit_cast<double>(d.Int(8)),
+             y = std::bit_cast<double>(d.Int(8));
+      double dx = 0, dy = 0;
+      uint64_t b = 0, count = 0;
+      if (type == 0x203) {
+        dx = std::bit_cast<double>(d.Int(8));
+        dy = std::bit_cast<double>(d.Int(8));
+      }
+      if (type == 0x201 || type == 0x202) {
+        b = d.Int(1);
+      }
+      auto buttons = d.Int(4);
+      if (b) {
+        count = d.Int(1);
+      }
+      if (!d.Done() || !std::isfinite(x) || !std::isfinite(y) ||
+          std::abs(x) > 100000 || std::abs(y) > 100000 || !std::isfinite(dx) ||
+          !std::isfinite(dy) || std::abs(dx) > 100000 ||
+          std::abs(dy) > 100000 || buttons > 31 ||
+          ((type == 0x201 || type == 0x202) &&
+           (!b || b > 5 || !count || count > 3))) {
+        return 1;
+      }
+      if (b) {
+        uint32_t bit = 1u << (b == 2 ? 2 : b == 3 ? 1 : b - 1);
+        if ((type == 0x201) != !!(buttons & bit)) {
+          return 1;
+        }
+      }
+      Enqueue(base::BindOnce(&Impl::Pointer, base::Unretained(this), type,
+                             gfx::PointF(x, y), dx, dy, b, buttons, count,
+                             modifiers));
+      return 0;
+    }
+    if (type == 0x207) {
+      auto focused = d.Int(1);
+      if (!d.Done() || focused > 1) {
+        return 1;
+      }
+      Enqueue(
+          base::BindOnce(&Impl::Focus, base::Unretained(this), focused != 0));
+      return 0;
+    }
+    if (type == 0x206) {
+      auto text = d.String();
+      if (!d.Done() || !TextValid(text)) {
+        return 1;
+      }
+      Enqueue(base::BindOnce(&Impl::Commit, base::Unretained(this),
+                             base::UTF8ToUTF16(text), modifiers, false));
+      return 0;
+    }
+    auto vk = d.Int(4);
+    auto code = d.String();
+    auto key = d.String();
+    auto text = d.String();
+    auto location = d.Int(1), repeat = d.Int(1), system = d.Int(1);
+    auto dom_code = ui::KeycodeConverter::CodeStringToDomCode(code);
+    auto dom_key = ui::KeycodeConverter::KeyStringToDomKey(key);
+    if (!d.Done() || vk > 255 || location > 3 || repeat > 1 || system > 1 ||
+        !TextValid(text) || code.find('\0') != std::string::npos ||
+        key.find('\0') != std::string::npos ||
+        (code.empty() && key != "Unidentified") ||
+        (!code.empty() && dom_code == ui::DomCode::NONE) ||
+        dom_key == ui::DomKey::NONE ||
+        (type == 0x205 && (!text.empty() || repeat))) {
+      return 1;
+    }
+    int flags = Flags(modifiers, 0) | ui::EF_IS_SYNTHESIZED;
+    if (repeat) {
+      flags |= ui::EF_IS_REPEAT;
+    }
+    if (location == 3) {
+      flags |= ui::EF_NUMPAD_KEY;
+    }
+    ui::KeyEvent event(type == 0x204 ? ui::EventType::kKeyPressed
+                                     : ui::EventType::kKeyReleased,
+                       static_cast<ui::KeyboardCode>(vk), dom_code, flags,
+                       dom_key, Stamp());
+    Enqueue(base::BindOnce(&Impl::Key, base::Unretained(this), event));
+    return 0;
+  }
+  void Pointer(uint16_t type,
+               gfx::PointF point,
+               double dx,
+               double dy,
+               uint64_t b,
+               uint32_t buttons,
+               uint64_t count,
+               uint32_t modifiers) {
+    auto* captured = views::DesktopCaptureClient::GetCaptureWindowGlobal();
+    if (captured && captured->GetRootWindow() != root_) {
+      fault_.Run(4);
+      Done();
+      return;
+    }
+    point_ = point;
+    buttons_ = buttons;
+    hover_ = true;
+    gfx::Point screen = root_->GetBoundsInScreen().origin() +
+                        gfx::ToRoundedPoint(point).OffsetFromOrigin();
+    display::win::GetScreenWinHeadless()->SetCursorScreenPointForTesting(
+        screen);
+    root_->GetHost()->ConvertDIPToPixels(&point);
+    auto stamp = Stamp();
+    std::unique_ptr<ui::Event> event;
+    if (type == 0x203) {
+      wheel_x_ -= dx;
+      wheel_y_ -= dy;
+      int ix = static_cast<int>(wheel_x_), iy = static_cast<int>(wheel_y_);
+      wheel_x_ -= ix;
+      wheel_y_ -= iy;
+      event = std::make_unique<ui::MouseWheelEvent>(
+          gfx::Vector2d(ix, iy), point, point, stamp,
+          Flags(modifiers, buttons) | ui::EF_PRECISION_SCROLLING_DELTA, 0);
+    } else {
+      auto mouse = std::make_unique<ui::MouseEvent>(
+          type == 0x201   ? ui::EventType::kMousePressed
+          : type == 0x202 ? ui::EventType::kMouseReleased
+          : buttons       ? ui::EventType::kMouseDragged
+                          : ui::EventType::kMouseMoved,
+          point, point, stamp, Flags(modifiers, buttons), b ? Button(b) : 0);
+      if (b) {
+        mouse->SetClickCount(count);
+      }
+      event = std::move(mouse);
+    }
+    Send(std::move(event), base::BindOnce(&Impl::Done, weak_.GetWeakPtr()));
+  }
+  void Focus(bool focused) {
+    if (auto* widget = Widget()) {
+      if (focused) {
+        widget->Activate();
+      } else {
+        Reset();
+        widget->Deactivate();
+      }
+    }
+    Done();
+  }
+  void Key(ui::KeyEvent event) {
+    event.set_time_stamp(Stamp());
+    if (event.type() == ui::EventType::kKeyPressed) {
+      keys_.insert_or_assign(event.key_code(), event);
+    } else {
+      keys_.erase(event.key_code());
+    }
+    const bool enter =
+        event.type() == ui::EventType::kKeyPressed &&
+        event.key_code() == ui::VKEY_RETURN &&
+        !(event.flags() &
+          (ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN)) &&
+        content::IsAuraContentTextClient(contents_.Run(), Client());
+    Send(std::make_unique<ui::KeyEvent>(event),
+         base::BindOnce(&Impl::KeyDone, weak_.GetWeakPtr(), enter));
+  }
+  void KeyDone(bool enter, bool success) {
+    if (enter && success &&
+        content::IsAuraContentTextClient(contents_.Run(), Client())) {
+      Commit(u"\r", 0, true);
+      return;
+    }
+    Done(success);
+  }
+  void Commit(std::u16string text, uint32_t modifiers, bool enter = false) {
+    auto* client = Client();
+    if (!client ||
+        (!enter && client->GetTextInputType() == ui::TEXT_INPUT_TYPE_NONE)) {
+      fault_.Run(4);
+      Done();
+      return;
+    }
+    if (text.empty()) {
+      Done();
+      return;
+    }
+    bool content_client =
+        content::IsAuraContentTextClient(contents_.Run(), client);
+    if (text.size() == 1) {
+      auto event = ui::KeyEvent::FromCharacter(
+          text[0], enter ? ui::VKEY_RETURN : ui::VKEY_UNKNOWN,
+          ui::DomCode::NONE, Flags(modifiers, 0), Stamp());
+      content::DispatchWithAuraInputBarrier(
+          contents_.Run(), event.time_stamp(),
+          base::BindOnce([](ui::TextInputClient* target,
+                            ui::KeyEvent event) { target->InsertChar(event); },
+                         base::Unretained(client), event),
+          base::BindOnce(&Impl::Done, weak_.GetWeakPtr()));
+    } else {
+      client->InsertText(
+          text,
+          ui::TextInputClient::InsertTextCursorBehavior::kMoveCursorAfterText);
+      if (content_client) {
+        content::FinishAuraTextCommit(
+            contents_.Run(),
+            base::BindOnce(&Impl::Done, weak_.GetWeakPtr(), true));
+      } else {
+        Done();
+      }
+    }
+  }
+
+ private:
+  raw_ptr<aura::Window> root_;
+  base::RepeatingCallback<content::WebContents*()> contents_;
+  base::RepeatingCallback<void(uint32_t)> fault_;
+  base::circular_deque<base::OnceClosure> queue_;
+  std::map<ui::KeyboardCode, ui::KeyEvent> keys_;
+  gfx::PointF point_;
+  uint32_t buttons_ = 0;
+  double wheel_x_ = 0, wheel_y_ = 0;
+  bool busy_ = false, hover_ = false;
+  base::TimeTicks last_stamp_;
+  base::OneShotTimer deadline_;
+  base::WeakPtrFactory<Impl> weak_{this};
+};
+PrtsWindowInput::PrtsWindowInput(
+    aura::Window* root,
+    base::RepeatingCallback<content::WebContents*()> contents,
+    base::RepeatingCallback<void(uint32_t)> fault)
+    : impl_(
+          std::make_unique<Impl>(root, std::move(contents), std::move(fault))) {
+}
+PrtsWindowInput::~PrtsWindowInput() = default;
+uint32_t PrtsWindowInput::Dispatch(uint16_t type,
+                                   Decoder& d,
+                                   uint32_t modifiers) {
+  return impl_->Dispatch(type, d, modifiers);
+}
+void PrtsWindowInput::Reset() {
+  impl_->Reset();
+}
+}  // namespace prts
