Date: Tue, 20 Oct 2026 15:31:37 +0800
Subject: [PATCH 30/38] Place external launch guard at the final launch
 boundary

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/chrome/browser/external_protocol/external_protocol_handler.cc b/chrome/browser/external_protocol/external_protocol_handler.cc
index 401706fba1..3fe2dece07 100644
--- a/chrome/browser/external_protocol/external_protocol_handler.cc
+++ b/chrome/browser/external_protocol/external_protocol_handler.cc
@@ -114,9 +114,6 @@ void AddMessageToConsole(const content::WeakDocumentPtr& document,
 scoped_refptr<shell_integration::DefaultSchemeClientWorker> CreateShellWorker(
     const GURL& url,
     ExternalProtocolHandler::Delegate* delegate) {
-  if (base::CommandLine::ForCurrentProcess()->HasSwitch("prts-pipe")) {
-    return;
-  }
   if (delegate) {
     return delegate->CreateShellWorker(url);
   }
@@ -180,6 +177,7 @@ void LaunchUrlWithoutSecurityCheckWithDelegate(
     content::WebContents* web_contents,
     content::WeakDocumentPtr initiator_document,
     ExternalProtocolHandler::Delegate* delegate) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("prts-pipe")) return;
   if (delegate) {
     delegate->LaunchUrlWithoutSecurityCheck(url, web_contents);
     return;
