From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Tue, 20 Oct 2026 14:56:15 +0800
Subject: [PATCH 24/38] Add opt-in PRTS Views geometry and compositor
 diagnostics

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/chrome/browser/prts/prts_window_registry.cc b/chrome/browser/prts/prts_window_registry.cc
index 323211bd63..b767ea756b 100644
--- a/chrome/browser/prts/prts_window_registry.cc
+++ b/chrome/browser/prts/prts_window_registry.cc
@@ -26,6 +26,11 @@
 #include "chrome/browser/ui/navigator/browser_navigator_params.h"
 #include "chrome/browser/ui/tabs/tab_strip_model.h"
 #include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/contents_web_view.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
+#include "chrome/browser/ui/views/tabs/tab_strip.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
 #include "content/public/browser/navigation_controller.h"
 #include "content/public/browser/navigation_handle.h"
 #include "content/public/browser/web_contents.h"
@@ -410,6 +415,52 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
       return;
     }
     auto id = d.Int(8);
+    if (r.type == 0x42d &&
+        base::CommandLine::ForCurrentProcess()->HasSwitch("prts-test-hooks")) {
+      if (!d.Done()) {
+        Error(r.id, 1, "Invalid geometry probe");
+        return;
+      }
+      auto it = windows_.find(id);
+      if (it == windows_.end()) {
+        Error(r.id, 2, "Unknown probe window");
+        return;
+      }
+      auto& w = it->second;
+      auto* root = Root(w);
+      auto* view = BrowserView::GetBrowserViewForBrowser(w.browser);
+      prts::Encoder e;
+      auto* host = root->GetHost();
+      e.Int(host->compositor()->size().width(), 4);
+      e.Int(host->compositor()->size().height(), 4);
+      e.Int(std::bit_cast<uint64_t>(
+                static_cast<double>(host->device_scale_factor())),
+            8);
+      auto origin = root->GetBoundsInScreen().origin();
+      auto bounds = [&](views::View* v) {
+        auto rect = v ? v->GetBoundsInScreen() : gfx::Rect();
+        rect.Offset(-origin.x(), -origin.y());
+        for (double value :
+             {static_cast<double>(rect.x()), static_cast<double>(rect.y()),
+              static_cast<double>(rect.width()),
+              static_cast<double>(rect.height())}) {
+          e.Int(std::bit_cast<uint64_t>(value), 8);
+        }
+      };
+      bounds(view->tab_strip_view());
+      bounds(view->toolbar());
+      bounds(view->GetLocationBarView());
+      bounds(view->contents_web_view_for_testing());
+      auto* strip = view->horizontal_tab_strip_for_testing();
+      e.Int(strip ? strip->GetTabCount() : 0, 4);
+      if (strip) {
+        for (int i = 0; i < strip->GetTabCount(); ++i) {
+          bounds(strip->tab_at(i));
+        }
+      }
+      send_.Run(0x48f, r.id, std::move(e.data));
+      return;
+    }
     if (r.type == 0x403 || r.type == 0x410 || r.type == 0x411) {
       Size size;
       bool valid = true;
