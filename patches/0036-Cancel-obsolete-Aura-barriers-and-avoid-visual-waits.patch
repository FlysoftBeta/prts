From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Tue, 20 Oct 2026 16:10:51 +0800
Subject: [PATCH 36/38] Cancel obsolete Aura barriers and avoid visual waits
 for pointer motion

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/chrome/browser/prts/prts_window_input.cc b/chrome/browser/prts/prts_window_input.cc
index debd2a3c83..8494397f47 100644
--- a/chrome/browser/prts/prts_window_input.cc
+++ b/chrome/browser/prts/prts_window_input.cc
@@ -137,10 +137,16 @@ class PrtsWindowInput::Impl : public aura::WindowObserver {
       return;
     }
     auto stamp = event->time_stamp();
-    content::DispatchWithAuraInputBarrier(
+    auto weak = weak_.GetWeakPtr();
+    auto cancel = content::DispatchWithAuraInputBarrier(
         contents_.Run(), stamp,
         base::BindOnce(&Impl::SendNow, weak_.GetWeakPtr(), std::move(event)),
         std::move(done));
+    if (weak) {
+      cancel_ = std::move(cancel);
+    } else if (cancel) {
+      std::move(cancel).Run();
+    }
   }
   void SendNow(std::unique_ptr<ui::Event> event) {
     if (!root_) {
@@ -150,6 +156,9 @@ class PrtsWindowInput::Impl : public aura::WindowObserver {
   }
   void Reset() {
     weak_.InvalidateWeakPtrs();
+    if (cancel_) {
+      std::move(cancel_).Run();
+    }
     deadline_.Stop();
     queue_.clear();
     busy_ = false;
@@ -157,6 +166,10 @@ class PrtsWindowInput::Impl : public aura::WindowObserver {
       return;
     }
     auto* host = root_->GetHost();
+    if (auto* capture = views::DesktopCaptureClient::GetCaptureWindowGlobal();
+        capture && capture->GetRootWindow() == root_) {
+      capture->ReleaseCapture();
+    }
     for (const auto& [vk, key] : keys_) {
       ui::KeyEvent release(ui::EventType::kKeyReleased, key.key_code(),
                            key.code(), ui::EF_IS_SYNTHESIZED, key.GetDomKey(),
@@ -167,7 +180,7 @@ class PrtsWindowInput::Impl : public aura::WindowObserver {
     for (uint32_t bit = 1; bit <= 16; bit <<= 1) {
       if (buttons_ & bit) {
         buttons_ &= ~bit;
-        gfx::PointF point = point_;
+        gfx::PointF point(-1, -1);
         host->ConvertDIPToPixels(&point);
         ui::MouseEvent up(ui::EventType::kMouseReleased, point, point, Stamp(),
                           Flags(0, buttons_), Flags(0, bit));
@@ -377,12 +390,18 @@ class PrtsWindowInput::Impl : public aura::WindowObserver {
       auto event = ui::KeyEvent::FromCharacter(
           text[0], enter ? ui::VKEY_RETURN : ui::VKEY_UNKNOWN,
           ui::DomCode::NONE, Flags(modifiers, 0), Stamp());
-      content::DispatchWithAuraInputBarrier(
+      auto weak = weak_.GetWeakPtr();
+      auto cancel = content::DispatchWithAuraInputBarrier(
           contents_.Run(), event.time_stamp(),
           base::BindOnce([](ui::TextInputClient* target,
                             ui::KeyEvent event) { target->InsertChar(event); },
                          base::Unretained(client), event),
           base::BindOnce(&Impl::Done, weak_.GetWeakPtr()));
+      if (weak) {
+        cancel_ = std::move(cancel);
+      } else if (cancel) {
+        std::move(cancel).Run();
+      }
     } else {
       client->InsertText(
           text,
@@ -409,6 +428,7 @@ class PrtsWindowInput::Impl : public aura::WindowObserver {
   bool busy_ = false, hover_ = false;
   base::TimeTicks last_stamp_;
   base::OneShotTimer deadline_;
+  base::OnceClosure cancel_;
   base::WeakPtrFactory<Impl> weak_{this};
 };
 PrtsWindowInput::PrtsWindowInput(
diff --git a/content/browser/renderer_host/aura_input_barrier.cc b/content/browser/renderer_host/aura_input_barrier.cc
index a9b9157d14..871c720ac3 100644
--- a/content/browser/renderer_host/aura_input_barrier.cc
+++ b/content/browser/renderer_host/aura_input_barrier.cc
@@ -54,6 +54,9 @@ class AuraBarrier final : public WebContentsObserver,
       PostPoll();
     }
   }
+  base::OnceClosure Cancellation() {
+    return base::BindOnce(&AuraBarrier::Finish, weak_.GetWeakPtr(), true);
+  }
   void OnInputEvent(const RenderWidgetHost& host,
                     const blink::WebInputEvent& event,
                     InputEventSource) override {
@@ -61,6 +64,9 @@ class AuraBarrier final : public WebContentsObserver,
       VLOG(1) << "Aura barrier forwarded type="
               << static_cast<int>(event.GetType()) << " stamp=" << stamp_;
       saw_dispatch_ = true;
+      needs_state_ |=
+          event.GetType() == blink::WebInputEvent::Type::kMouseDown ||
+          blink::WebInputEvent::IsKeyboardEventType(event.GetType());
       ++pending_[{&host, event.GetType()}];
     }
   }
@@ -107,7 +113,7 @@ class AuraBarrier final : public WebContentsObserver,
       PostPoll();
       return;
     }
-    if (!saw_dispatch_) {
+    if (!saw_dispatch_ || !needs_state_) {
       Finish(true);
       return;
     }  // Views consumed / target lost.
@@ -151,21 +157,25 @@ class AuraBarrier final : public WebContentsObserver,
            size_t>
       pending_;
   bool saw_dispatch_ = false;
+  bool needs_state_ = false;
   base::OneShotTimer timeout_;
   base::WeakPtrFactory<AuraBarrier> weak_{this};
 };
 }  // namespace
-void DispatchWithAuraInputBarrier(WebContents* contents,
-                                  base::TimeTicks stamp,
-                                  base::OnceClosure dispatch,
-                                  base::OnceCallback<void(bool)> done) {
+base::OnceClosure DispatchWithAuraInputBarrier(
+    WebContents* contents,
+    base::TimeTicks stamp,
+    base::OnceClosure dispatch,
+    base::OnceCallback<void(bool)> done) {
   if (!contents) {
     std::move(dispatch).Run();
     std::move(done).Run(true);
-    return;
+    return {};
   }
-  (new AuraBarrier(contents, stamp, std::move(done)))
-      ->Begin(std::move(dispatch));
+  auto* barrier = new AuraBarrier(contents, stamp, std::move(done));
+  auto cancel = barrier->Cancellation();
+  barrier->Begin(std::move(dispatch));
+  return cancel;
 }
 bool IsAuraContentTextClient(WebContents* contents,
                              const ui::TextInputClient* client) {
diff --git a/content/public/browser/aura_input_barrier.h b/content/public/browser/aura_input_barrier.h
index ae72bddb50..b8e92aef96 100644
--- a/content/public/browser/aura_input_barrier.h
