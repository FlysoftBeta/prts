From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Tue, 20 Oct 2026 15:02:52 +0800
Subject: [PATCH 26/38] Keep fractional PRTS root layout within the requested
 logical canvas

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/chrome/browser/prts/prts_window_registry.cc b/chrome/browser/prts/prts_window_registry.cc
index 0530854649..c8750e4fa0 100644
--- a/chrome/browser/prts/prts_window_registry.cc
+++ b/chrome/browser/prts/prts_window_registry.cc
@@ -245,6 +245,11 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
                     outer.height() + pixels.height() - client.height()));
       root->GetHost()->SetBoundsInPixels(outer);
     }
+    // Aura normally encloses physical pixels back to integer DIPs. At a
+    // fractional scale that can add one logical pixel to the requested size.
+    // Retain the protocol's logical canvas; the compositor still allocates
+    // ceil(DIP * DSF) device pixels.
+    root->SetBounds(gfx::Rect(w.size.width, w.size.height));
   }
   void Scene(Window& w) {
     prts::Encoder e;
