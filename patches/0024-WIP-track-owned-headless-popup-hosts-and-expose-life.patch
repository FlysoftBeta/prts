@@ -0,0 +1,213 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/prts/prts_host_tracker.h"
+
+#include <algorithm>
+#include <map>
+#include <set>
+#include <tuple>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_multi_source_observation.h"
+#include "base/scoped_observation.h"
+#include "ui/aura/env.h"
+#include "ui/aura/env_observer.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/views/bubble/bubble_dialog_delegate_view.h"
+#include "ui/views/widget/desktop_aura/desktop_headless_input.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_delegate.h"
+#include "ui/views/widget/widget_observer.h"
+#include "ui/wm/core/window_util.h"
+
+namespace prts {
+class PrtsHostTracker::Impl : public aura::EnvObserver,
+                              public views::WidgetObserver {
+ public:
+  Impl(Owner owner, base::RepeatingCallback<uint64_t()> allocate,
+       base::RepeatingClosure changed)
+      : owner_(std::move(owner)), allocate_(std::move(allocate)),
+        changed_(std::move(changed)) {
+    env_.Observe(aura::Env::GetInstance());
+    views::SetHeadlessHostObserver(base::BindRepeating(
+        &Impl::HostEvent, weak_.GetWeakPtr()));
+    // Bootstrap existing, fully initialized hosts. New hosts remain provisional
+    // until OnWidgetInitDone, even when Aura announced their root earlier.
+    for (const auto& host : aura::Env::GetInstance()->window_tree_hosts()) {
+      auto* widget = views::Widget::GetTopLevelWidgetForNativeView(host->window());
+      if (widget) {
+        HostEvent(views::HeadlessHostEvent::kReady, host.get(), widget, nullptr, nullptr);
+      }
+    }
+  }
+  ~Impl() override {
+    views::SetHeadlessHostObserver({});
+    widgets_.RemoveAllObservations();
+    env_.Reset();
+  }
+  struct Node {
+    base::WeakPtr<aura::Window> root, parent, context;
+    base::WeakPtr<views::Widget> widget;
+    OwnedHost info;
+    bool ready = false;
+  };
+  void HostEvent(views::HeadlessHostEvent event, aura::WindowTreeHost* host,
+                 views::Widget* widget, const views::HeadlessHostInfo* info,
+                 aura::Window* relative) {
+    auto [it, inserted] = nodes_.try_emplace(host->window());
+    auto& node = it->second;
+    if (inserted) {
+      node.root = host->window()->GetWeakPtrAsWindow();
+      node.info.source = allocate_.Run();
+      node.info.order = ++order_;
+    }
+    if (widget) { node.widget = widget->GetWeakPtr(); }
+    if (info) {
+      node.parent = info->parent ? info->parent->GetWeakPtrAsWindow() : nullptr;
+      node.context = info->context ? info->context->GetWeakPtrAsWindow() : nullptr;
+      node.info.type = info->type;
+      node.info.corners = info->corners;
+      node.info.shadow = info->shadow;
+      node.info.z_order = info->z_order;
+      node.info.accepts_input = info->accepts_input;
+      node.info.translucent = info->translucent;
+    }
+    if (event == views::HeadlessHostEvent::kReady && widget) {
+      node.ready = true;
+      node.info.translucent = widget->ShouldWindowContentsBeTransparent();
+      if (!widgets_.IsObservingSource(widget)) { widgets_.AddObservation(widget); }
+    }
+    if (event == views::HeadlessHostEvent::kStackAbove ||
+        event == views::HeadlessHostEvent::kStackAtTop) {
+      // Preserve the actual request even though headless HWND stacking is a
+      // no-op. Descendant relationships are resolved separately below.
+      node.info.order = ++order_;
+      if (event == views::HeadlessHostEvent::kStackAbove && relative) {
+        auto below = nodes_.find(relative->GetRootWindow());
+        if (below != nodes_.end() && below != it) {
+          std::vector<Node*> order;
+          for (auto& [root, other] : nodes_) {
+            if (&other != &node) { order.push_back(&other); }
+          }
+          std::ranges::sort(order, {}, [](Node* n) { return n->info.order; });
+          auto position = std::ranges::find(order, &below->second);
+          order.insert(position + 1, &node);
+          for (auto* ordered : order) { ordered->info.order = ++order_; }
+        }
+      }
+    }
+    changed_.Run();
+  }
+  void OnHostInitialized(aura::WindowTreeHost*) override {}
+  void OnHostDestroyed(aura::WindowTreeHost* host) override {
+    auto it = nodes_.find(host->window());
+    if (it == nodes_.end()) { return; }
+    auto* widget = it->second.widget.get();
+    if (widget && widgets_.IsObservingSource(widget)) {
+      widgets_.RemoveObservation(widget);
+    }
+    nodes_.erase(it);
+    changed_.Run();
+  }
+  void Remove(views::Widget* widget) {
+    if (widgets_.IsObservingSource(widget)) { widgets_.RemoveObservation(widget); }
+    std::erase_if(nodes_, [widget](const auto& pair) {
+      return pair.second.widget.get() == widget;
+    });
+    changed_.Run();
+  }
+  void OnWidgetDestroying(views::Widget* widget) override { Remove(widget); }
+  void OnWidgetDestroyed(views::Widget* widget) override { Remove(widget); }
+  void OnWidgetVisibilityChanged(views::Widget* widget, bool visible) override {
+    for (auto& [root, node] : nodes_) {
+      if (node.widget.get() == widget) {
+        ++node.info.generation;
+        if (visible) { node.info.order = ++order_; }
+      }
+    }
+    changed_.Run();
+  }
+  void OnWidgetBoundsChanged(views::Widget* widget, const gfx::Rect&) override {
+    for (auto& [root, node] : nodes_) {
+      if (node.widget.get() == widget) { ++node.info.generation; }
+    }
+    changed_.Run();
+  }
+  void OnWidgetActivationChanged(views::Widget*, bool) override { changed_.Run(); }
+  void OnWidgetChildAdded(views::Widget*, views::Widget*) override { changed_.Run(); }
+  void OnWidgetChildRemoved(views::Widget*, views::Widget*) override { changed_.Run(); }
+
+  uint64_t Resolve(aura::Window* window, std::set<aura::Window*>& visited) const {
+    if (!window || !visited.insert(window).second) { return 0; }
+    if (uint64_t id = owner_.Run(window->GetRootWindow())) { return id; }
+    if (auto it = nodes_.find(window->GetRootWindow()); it != nodes_.end()) {
+      const auto& node = it->second;
+      if (uint64_t id = Resolve(node.parent.get(), visited)) { return id; }
+      if (uint64_t id = Resolve(node.context.get(), visited)) { return id; }
+      if (auto* widget = node.widget.get()) {
+        if (auto* parent = widget->parent()) {
+          if (uint64_t id = Resolve(parent->GetNativeWindow(), visited)) { return id; }
+        }
+        if (auto* delegate = widget->widget_delegate()) {
+          if (auto* bubble = delegate->AsBubbleDialogDelegate()) {
+            if (auto* anchor = bubble->anchor_widget()) {
+              if (uint64_t id = Resolve(anchor->GetNativeWindow(), visited)) { return id; }
+            }
+          }
+        }
+      }
+    }
+    if (uint64_t id = Resolve(wm::GetTransientParent(window), visited)) { return id; }
+    return Resolve(window->parent(), visited);
+  }
+  std::vector<OwnedHost> Snapshot(uint64_t owner) const {
+    std::vector<OwnedHost> result;
+    for (const auto& [root, node] : nodes_) {
+      if (!node.ready || !node.root || !node.widget || !node.widget->IsVisible() ||
+          owner_.Run(node.root.get())) { continue; }
+      std::set<aura::Window*> visited;
+      uint64_t resolved = Resolve(node.widget->GetNativeWindow(), visited);
+      if (!resolved || resolved != owner) { continue; }
+      OwnedHost info = node.info;
+      info.root = node.root.get();
+      info.owner = resolved;
+      for (auto* candidate : {node.parent.get(), node.context.get()}) {
+        if (!candidate || owner_.Run(candidate->GetRootWindow())) { continue; }
+        auto parent = nodes_.find(candidate->GetRootWindow());
+        if (parent != nodes_.end() && parent->first != root) {
+          info.parent_source = parent->second.info.source;
+          break;
+        }
+      }
+      info.screen_bounds = node.widget->GetClientAreaBoundsInScreen();
+      info.dpr = node.root->GetHost()->device_scale_factor();
+      result.push_back(info);
+    }
+    std::ranges::sort(result, {}, [](const OwnedHost& h) {
+      return std::tuple(h.z_order, h.order);
+    });
+    return result;
+  }
+
+ private:
+  Owner owner_;
+  base::RepeatingCallback<uint64_t()> allocate_;
+  base::RepeatingClosure changed_;
+  uint64_t order_ = 0;
+  std::map<aura::Window*, Node> nodes_;
+  base::ScopedObservation<aura::Env, aura::EnvObserver> env_{this};
+  base::ScopedMultiSourceObservation<views::Widget, views::WidgetObserver> widgets_{this};
+  base::WeakPtrFactory<Impl> weak_{this};
+};
+PrtsHostTracker::PrtsHostTracker(Owner owner,
+    base::RepeatingCallback<uint64_t()> allocate, base::RepeatingClosure changed)
+    : impl_(std::make_unique<Impl>(std::move(owner), std::move(allocate),
+                                   std::move(changed))) {}
+PrtsHostTracker::~PrtsHostTracker() = default;
+std::vector<OwnedHost> PrtsHostTracker::Snapshot(uint64_t owner) const {
+  return impl_->Snapshot(owner);
+}
+}  // namespace prts
