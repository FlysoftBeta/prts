+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_PRTS_PRTS_HOST_TRACKER_H_
+#define CHROME_BROWSER_PRTS_PRTS_HOST_TRACKER_H_
+
+#include <memory>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+
+namespace aura { class Window; }
+namespace prts {
+// UI-sequence snapshots. Pointers are borrowed only until the next UI dispatch;
+// protocol identities are allocated separately and never reuse a native address.
+struct OwnedHost {
+  uint64_t source = 0;
+  uint64_t generation = 1;
+  uint64_t owner = 0;
+  uint64_t parent_source = 0;
+  raw_ptr<aura::Window> root = nullptr;
+  gfx::Rect screen_bounds;
+  gfx::RoundedCornersF corners;
+  double dpr = 1;
+  uint64_t order = 0;
+  int type = 0;
+  int z_order = 0;
+  int shadow = 0;
+  bool accepts_input = true;
+  bool translucent = false;
+};
+class PrtsHostTracker {
+ public:
+  using Owner = base::RepeatingCallback<uint64_t(aura::Window*)>;
+  PrtsHostTracker(Owner owner, base::RepeatingCallback<uint64_t()> allocate,
+                  base::RepeatingClosure changed);
+  ~PrtsHostTracker();
+  std::vector<OwnedHost> Snapshot(uint64_t owner) const;
+
+ private:
+  class Impl;
+  std::unique_ptr<Impl> impl_;
+};
+}  // namespace prts
+#endif
