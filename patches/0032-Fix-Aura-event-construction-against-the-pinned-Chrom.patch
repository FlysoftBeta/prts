From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Tue, 20 Oct 2026 15:42:37 +0800
Subject: [PATCH 32/38] Fix Aura event construction against the pinned Chromium
 API

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/chrome/browser/prts/prts_window_input.cc b/chrome/browser/prts/prts_window_input.cc
index 18292c9bdc..797322737a 100644
--- a/chrome/browser/prts/prts_window_input.cc
+++ b/chrome/browser/prts/prts_window_input.cc
@@ -87,7 +87,7 @@ class PrtsWindowInput::Impl : public aura::WindowObserver {
   }
   views::Widget* Widget() {
     if (root_) {
-      for (auto* child : root_->children()) {
+      for (auto child : root_->children()) {
         if (auto* widget = views::Widget::GetWidgetForNativeWindow(child)) {
           return widget;
         }
@@ -268,9 +268,7 @@ class PrtsWindowInput::Impl : public aura::WindowObserver {
     if (repeat) {
       flags |= ui::EF_IS_REPEAT;
     }
-    if (location == 3) {
-      flags |= ui::EF_NUMPAD_KEY;
-    }
+
     ui::KeyEvent event(type == 0x204 ? ui::EventType::kKeyPressed
                                      : ui::EventType::kKeyReleased,
                        static_cast<ui::KeyboardCode>(vk), dom_code, flags,
@@ -336,8 +334,8 @@ class PrtsWindowInput::Impl : public aura::WindowObserver {
     }
     Done();
   }
-  void Key(ui::KeyEvent event) {
-    event.set_time_stamp(Stamp());
+  void Key(ui::KeyEvent queued) {
+    ui::KeyEvent event(queued.type(), queued.key_code(), queued.code(), queued.flags(), queued.GetDomKey(), Stamp());
     if (event.type() == ui::EventType::kKeyPressed) {
       keys_.insert_or_assign(event.key_code(), event);
     } else {
