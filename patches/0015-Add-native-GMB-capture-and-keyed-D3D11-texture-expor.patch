+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_PRTS_PRTS_D3D_H_
+#define CHROME_BROWSER_PRTS_PRTS_D3D_H_
+#include <d3d11_1.h>
+#include <dxgi1_2.h>
+#include <wrl/client.h>
+
+#include "base/win/scoped_handle.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace prts {
+// Browser-owned export pool. Viz's key-0-only mutex never crosses the wire.
+class PrtsD3D {
+ public:
+  PrtsD3D();
+  ~PrtsD3D();
+  struct Texture {
+    Microsoft::WRL::ComPtr<ID3D11Texture2D> image;
+    Microsoft::WRL::ComPtr<IDXGIKeyedMutex> mutex;
+    base::win::ScopedHandle handle;
+  };
+  bool Initialize(uint64_t luid);
+  bool Create(gfx::Size size, Texture& texture);
+  // Returns only after source reads finish; the caller may release its Viz lease.
+  bool Copy(HANDLE source, const gfx::Rect& visible, Texture& destination,
+            bool& unsafe_failure);
+
+ private:
+  Microsoft::WRL::ComPtr<ID3D11Device1> device_;
+  Microsoft::WRL::ComPtr<ID3D11DeviceContext> context_;
+};
+}  // namespace prts
+#endif
