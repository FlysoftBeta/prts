From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Tue, 20 Oct 2026 15:08:25 +0800
Subject: [PATCH 27/38] Fix unsupported window input diagnostics and fractional
 client layout

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/chrome/browser/prts/prts_controller.cc b/chrome/browser/prts/prts_controller.cc
index 338200d2ac..2b28069bda 100644
--- a/chrome/browser/prts/prts_controller.cc
+++ b/chrome/browser/prts/prts_controller.cc
@@ -136,7 +136,11 @@ void PrtsController::Receive(Record record) {
   if (ready_ && record.type >= 0x200 && record.type <= 0x207 &&
       record.id == 0) {
     if (major_ == 2) {
-      Error(0, 4, "Window input is not enabled");
+      Encoder fault;
+      fault.Int(4, 4);
+      fault.String("Window input is not enabled");
+      fault.Int(0, 1);
+      Send(8, 0, std::move(fault.data));
     } else {
       targets_->Input(record.type, record.payload);
     }
diff --git a/chrome/browser/prts/prts_window_registry.cc b/chrome/browser/prts/prts_window_registry.cc
index c8750e4fa0..6119cfb599 100644
--- a/chrome/browser/prts/prts_window_registry.cc
+++ b/chrome/browser/prts/prts_window_registry.cc
@@ -250,6 +250,8 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
     // Retain the protocol's logical canvas; the compositor still allocates
     // ceil(DIP * DSF) device pixels.
     root->SetBounds(gfx::Rect(w.size.width, w.size.height));
+    w.browser->GetWindow()->GetNativeWindow()->SetBounds(
+        gfx::Rect(w.size.width, w.size.height));
   }
   void Scene(Window& w) {
     prts::Encoder e;
