From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Wed, 21 Oct 2026 16:27:16 +0800
Subject: [PATCH 34/34] WIP: disable Aura window animations for immediate PRTS
 UI

The non-component release select-popup gate crashes when zero-duration hide animation destroys its layer before DesktopWindowTreeHostWin::Close queries the animator. PRTS already disables browser UI animation durations; also use the existing wm-window-animations-disabled switch to skip the Aura hide-animation path. No upstream window-lifecycle patch is needed. Release GPU2/CPU1/GPU1 gates pass; CPU2 fixture startup and full requalification are pending.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/chrome/browser/prts/prts_controller.cc b/chrome/browser/prts/prts_controller.cc
index ccea99511b..bc07f69590 100644
--- a/chrome/browser/prts/prts_controller.cc
+++ b/chrome/browser/prts/prts_controller.cc
@@ -15,6 +15,7 @@
 #include "gpu/config/gpu_info.h"
 #include "ui/gfx/scoped_animation_duration_scale_mode.h"
 #include "ui/views/widget/desktop_aura/desktop_headless_input.h"
+#include "ui/wm/core/wm_core_switches.h"
 
 namespace prts {
 PrtsController::PrtsController() = default;
@@ -28,6 +29,10 @@ void PrtsController::Prepare() {
   // animations run in separate processes and keep their normal timing.
   ui_animation_mode_ = std::make_unique<gfx::ScopedAnimationDurationScaleMode>(
       gfx::ScopedAnimationDurationScaleMode::DISABLE_ANIMATION);
+  // Zero-duration Aura hide animations can destroy the popup layer before
+  // DesktopWindowTreeHostWin::Close inspects its animator. Skip that path too.
+  base::CommandLine::ForCurrentProcess()->AppendSwitch(
+      wm::switches::kWindowAnimationsDisabled);
   base::CommandLine::ForCurrentProcess()->AppendSwitch(
       "disable-cursor-event-hook");
   VLOG(1) << "PRTS prepare";
