 DEFINE_UI_CLASS_PROPERTY_TYPE(views::DesktopWindowTreeHostWin*)
 
 namespace views {
+namespace {
+struct HeadlessInputState {
+  bool enabled = false;
+  uint64_t blocked = 0;
+  uint64_t writes = 0;
+  HeadlessCursorObserver cursor;
+};
+HeadlessInputState& HeadlessState() {
+  static base::NoDestructor<HeadlessInputState> state;
+  return *state;
+}
+}  // namespace
+void EnableDesktopHeadlessInput() {
+  HeadlessState().enabled = true;
+}
+bool DesktopHeadlessInputEnabled() {
+  return HeadlessState().enabled;
+}
+void SetHeadlessCursorObserver(HeadlessCursorObserver observer) {
+  HeadlessState().cursor = std::move(observer);
+}
+uint64_t BlockedHeadlessNativeCursorCalls() {
+  return HeadlessState().blocked;
+}
+uint64_t NativeCursorWriteCalls() {
+  return HeadlessState().writes;
+}
+void RecordNativeCursorWrite() {
+  ++HeadlessState().writes;
+}
+bool SuppressHeadlessNativeCursorCall() {
+  if (!HeadlessState().enabled) {
+    return false;
+  }
+  ++HeadlessState().blocked;
+  return true;
+}
 
