+++ b/ui/views/widget/desktop_aura/desktop_headless_input.h
@@ -0,0 +1,29 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef UI_VIEWS_WIDGET_DESKTOP_AURA_DESKTOP_HEADLESS_INPUT_H_
+#define UI_VIEWS_WIDGET_DESKTOP_AURA_DESKTOP_HEADLESS_INPUT_H_
+#include <stdint.h>
+
+#include "base/functional/callback.h"
+#include "ui/views/views_export.h"
+namespace aura {
+class WindowTreeHost;
+}
+namespace ui {
+class Cursor;
+}
+namespace views {
+using HeadlessCursorObserver = base::RepeatingCallback<
+    void(aura::WindowTreeHost*, const ui::Cursor&, bool)>;
+// UI-sequence opt-in, installed before any desktop Widget is created.
+VIEWS_EXPORT void EnableDesktopHeadlessInput();
+VIEWS_EXPORT bool DesktopHeadlessInputEnabled();
+VIEWS_EXPORT void SetHeadlessCursorObserver(HeadlessCursorObserver observer);
+VIEWS_EXPORT uint64_t BlockedHeadlessNativeCursorCalls();
+VIEWS_EXPORT uint64_t NativeCursorWriteCalls();
+VIEWS_EXPORT void RecordNativeCursorWrite();
+// Returns true when the native operation must be suppressed.
+VIEWS_EXPORT bool SuppressHeadlessNativeCursorCall();
+}  // namespace views
+#endif
