From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Tue, 20 Oct 2026 16:26:36 +0800
Subject: [PATCH 37/38] Release navigation paint holding before explicit Aura
 input and tighten window state

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/chrome/browser/prts/prts_window_registry.cc b/chrome/browser/prts/prts_window_registry.cc
index d4e904beb0..cc0647956b 100644
--- a/chrome/browser/prts/prts_window_registry.cc
+++ b/chrome/browser/prts/prts_window_registry.cc
@@ -89,15 +89,32 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
     uint32_t fps = 0, inflight = 0, mode = 0;
     bool gpu_failed = false;
     std::unique_ptr<prts::PrtsWindowInput> input = nullptr;
+    base::CallbackListSubscription close_cancelled = {};
+    int display_slot = -1;
   };
   class Tab : public content::WebContentsObserver {
    public:
     Tab(Impl* owner, content::WebContents* contents, uint64_t id)
-        : WebContentsObserver(contents), owner(owner), id(id) {}
-    void DidStartLoading() override { owner->Schedule(); }
-    void DidStopLoading() override { owner->Schedule(); }
+        : WebContentsObserver(contents), owner(owner), id(id) {
+      load = contents->IsLoading() ? 1 : 2;
+    }
+    void DidStartLoading() override {
+      load = 1;
+      owner->Schedule();
+    }
+    void DidStopLoading() override {
+      if (load != 3) {
+        load = 2;
+      }
+      owner->Schedule();
+    }
     void TitleWasSet(content::NavigationEntry*) override { owner->Schedule(); }
     void DidFinishNavigation(content::NavigationHandle* nav) override {
+      if (nav->IsInPrimaryMainFrame() &&
+          (nav->IsErrorPage() ||
+           (!nav->HasCommitted() && nav->GetNetErrorCode() != 0))) {
+        load = 3;
+      }
       if (nav->IsInPrimaryMainFrame() && nav->HasCommitted() &&
           !nav->IsSameDocument()) {
         owner->Navigated(web_contents());
@@ -108,10 +125,14 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
       Observe(nullptr);
       owner->Schedule();
     }
-    void Replace(content::WebContents* contents) { Observe(contents); }
+    void Replace(content::WebContents* contents) {
+      Observe(contents);
+      load = contents->IsLoading() ? 1 : 2;
+    }
     raw_ptr<Impl> owner;
     const uint64_t id;
     uint64_t opener = 0;
+    uint8_t load = 0;
   };
   void Start(uint64_t gpu_luid, uint32_t frame_limit) {
     views::SetHeadlessCursorObserver(
@@ -126,8 +147,8 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
     }
     e.Int(512ull * 1024 * 1024, 8);
     e.Int(512ull * 1024 * 1024, 8);
-    e.Int(1, 4);
-    e.Int(1, 4);
+    e.Int(640, 4);
+    e.Int(480, 4);
     send_.Run(0x494, 0, std::move(e.data));
     GlobalBrowserCollection::GetInstance()->ForEach(
         [this](BrowserWindowInterface* browser) {
@@ -343,14 +364,19 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
         base::TruncateUTF8ToByteSize(contents->GetVisibleURL().spec(), 65536));
     e.String(base::TruncateUTF8ToByteSize(
         base::UTF16ToUTF8(contents->GetTitle()), 65536));
-    e.Int(contents->IsLoading() ? 1 : 2, 1);
+    e.Int(t->load, 1);
     e.Int(w.browser->GetTabStripModel()->GetActiveWebContents() == contents, 1);
   }
   std::vector<uint8_t> Snapshot(Window& w) {
     auto* strip = w.browser->GetTabStripModel();
     prts::Encoder e;
     e.Int(w.id, 8);
-    e.Int(w.browser->GetType() == BrowserWindowInterface::TYPE_NORMAL ? 1 : 2,
+    auto kind = w.browser->GetType();
+    e.Int(kind == BrowserWindowInterface::TYPE_NORMAL ? 1
+          : (kind == BrowserWindowInterface::TYPE_POPUP ||
+             kind == BrowserWindowInterface::TYPE_APP_POPUP)
+              ? 2
+              : 3,
           1);
     e.Int(0, 8);
     e.Int(w.size.width, 4);
@@ -397,7 +423,19 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
     // Each Browser owns a separate synthetic monitor. This mutates headless
     // Screen only; it never changes physical Windows display configuration.
     display::Display monitor(w.display);
-    const int x = static_cast<int>(w.id) * 32768;
+    if (w.display_slot < 0) {
+      std::set<int> used;
+      for (const auto& [id, other] : windows_) {
+        if (other.display_slot >= 0) {
+          used.insert(other.display_slot);
+        }
+      }
+      w.display_slot = 0;
+      while (used.contains(w.display_slot)) {
+        ++w.display_slot;
+      }
+    }
+    const int x = (w.display_slot + 1) * 32768;
     const gfx::Rect pixels(gfx::Point(x, 0), DeviceSize(w));
     monitor.SetScaleAndBounds(w.size.dpr, pixels);
     if (w.display) {
@@ -505,6 +543,21 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
     }
     uint64_t id = ++next_, source = ++next_;
     windows_.emplace(id, Window{id, source, browser, {}});
+    windows_.at(id).close_cancelled =
+        browser->RegisterBrowserCloseCancelled(base::BindRepeating(
+            [](base::WeakPtr<Impl> owner, uint64_t id, BrowserWindowInterface*,
+               BrowserWindowInterface::ClosingStatus) {
+              if (!owner) {
+                return;
+              }
+              auto it = owner->windows_.find(id);
+              if (it == owner->windows_.end()) {
+                return;
+              }
+              it->second.closing = false;
+              owner->Publish(it->second);
+            },
+            weak_.GetWeakPtr(), id));
     browser->GetTabStripModel()->AddObserver(this);
     Schedule();
   }
@@ -551,9 +604,10 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
     size.width = d.Int(4);
     size.height = d.Int(4);
     size.dpr = std::bit_cast<double>(d.Int(8));
-    return size.width && size.width <= 8192 && size.height &&
+    return size.width >= 640 && size.width <= 8192 && size.height >= 480 &&
            size.height <= 8192 && std::isfinite(size.dpr) && size.dpr >= .5 &&
-           size.dpr <= 4 &&
+           size.dpr <= 4 && std::ceil(size.width * size.dpr) <= 16384 &&
+           std::ceil(size.height * size.dpr) <= 16384 &&
            std::ceil(size.width * size.dpr) *
                    std::ceil(size.height * size.dpr) <=
                64000000;
@@ -664,9 +718,10 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
       e.Int(views::NativeCursorWriteCalls(), 8);
       std::set<content::RenderWidgetHost*> widgets;
       if (auto* contents = Contents(id)) {
-        contents->ForEachRenderFrameHost([&](content::RenderFrameHost* frame) {
-          widgets.insert(frame->GetRenderWidgetHost());
-        });
+        contents->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+            [&](content::RenderFrameHost* frame) {
+              widgets.insert(frame->GetRenderWidgetHost());
+            });
       }
       e.Int(widgets.size(), 4);
       e.String(base::UTF16ToUTF8(
diff --git a/content/browser/renderer_host/aura_input_barrier.cc b/content/browser/renderer_host/aura_input_barrier.cc
index 871c720ac3..5a4a3692c3 100644
--- a/content/browser/renderer_host/aura_input_barrier.cc
+++ b/content/browser/renderer_host/aura_input_barrier.cc
@@ -30,13 +30,20 @@ class AuraBarrier final : public WebContentsObserver,
               base::TimeTicks stamp,
               base::OnceCallback<void(bool)> done)
       : WebContentsObserver(contents), stamp_(stamp), done_(std::move(done)) {
-    contents->ForEachRenderFrameHost([&](RenderFrameHost* frame) {
-      auto* host = frame->GetRenderWidgetHost();
-      if (hosts_.insert(host).second) {
-        host->AddInputEventObserver(this);
-        host->AddObserver(this);
-      }
-    });
+    contents->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+        [&](RenderFrameHost* frame) {
+          auto* host = frame->GetRenderWidgetHost();
+          if (hosts_.insert(host).second) {
+            // As in the legacy injector: an explicit remote action targets the
+            // new document, not a retained paint-holding snapshot that drops
+            // its first press. This changes readiness only, never injects a
+            // renderer event.
+            RenderWidgetHostImpl::From(host)
+                ->ForceFirstFrameAfterNavigationTimeout();
+            host->AddInputEventObserver(this);
+            host->AddObserver(this);
+          }
+        });
     timeout_.Start(
         FROM_HERE, base::Seconds(5),
         base::BindOnce(&AuraBarrier::Finish, weak_.GetWeakPtr(), false));
