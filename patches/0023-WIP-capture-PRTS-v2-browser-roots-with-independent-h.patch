+  void ApplySize(Window& w) {
+    auto* root = Root(w);
+    if (!root) {
+      return;
+    }
+    // Each Browser owns a separate synthetic monitor. This mutates headless
+    // Screen only; it never changes physical Windows display configuration.
+    display::Display monitor(w.display);
+    const int x = static_cast<int>(w.id) * 32768;
+    const gfx::Rect pixels(gfx::Point(x, 0), DeviceSize(w));
+    monitor.SetScaleAndBounds(w.size.dpr, pixels);
+    if (w.display) {
+      display::HeadlessScreenManager::Get()->UpdateDisplay(monitor);
+    } else {
+      w.display = display::HeadlessScreenManager::Get()->AddDisplay(monitor);
+    }
+    root->GetHost()->SetBoundsInPixels(pixels);
+  }
+  void Scene(Window& w) {
