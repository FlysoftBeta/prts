@@ -62,6 +65,7 @@
 #include "ui/display/screen.h"
 #include "ui/views/accessibility/view_accessibility.h"
 #include "ui/views/controls/menu/menu_item_view.h"
+#include "ui/views/controls/webview/webview.h"
 #include "ui/views/focus/focus_manager.h"
 #include "ui/views/view_utils.h"
 #include "ui/views/widget/desktop_aura/desktop_headless_input.h"
@@ -837,6 +841,97 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
       return;
     }
     auto id = d.Int(8);
+    if (r.type == 0x42b &&
+        base::CommandLine::ForCurrentProcess()->HasSwitch("prts-test-hooks")) {
+      if (!d.Done() || !windows_.contains(id)) {
+        Error(r.id, 1, "Invalid omnibox geometry probe");
+        return;
+      }
+      views::WebView* popup = nullptr;
+      auto find = [&](auto&& self, views::View* view) -> void {
+        if (!view->IsDrawn()) {
+          return;
+        }
+        if (auto* web = views::AsViewClass<views::WebView>(view);
+            web && web->web_contents()) {
+          if (web->web_contents()->GetLastCommittedURL().host() ==
+                  "omnibox-popup.top-chrome" &&
+              (!popup || view->GetBoundsInScreen().size().GetArea() >
+                             popup->GetBoundsInScreen().size().GetArea())) {
+            popup = web;
+          }
+        }
+        for (views::View* child : view->children()) {
+          self(self, child);
+        }
+      };
+      for (views::Widget* widget :
+           views::Widget::GetAllChildWidgets(Root(windows_.at(id)))) {
+        find(find, widget->GetRootView());
+      }
+      for (const auto& host : hosts_->Snapshot(id)) {
+        for (views::Widget* widget :
+             views::Widget::GetAllChildWidgets(host.root)) {
+          find(find, widget->GetRootView());
+        }
+      }
+      if (!popup) {
+        send_.Run(7, r.id, std::vector<uint8_t>(32));
+        return;
+      }
+      auto bounds = popup->GetBoundsInScreen();
+      if (bounds.width() <= 1 || bounds.height() <= 1) {
+        send_.Run(7, r.id, std::vector<uint8_t>(32));
+        return;
+      }
+      const auto origin = Root(windows_.at(id))->GetBoundsInScreen().origin();
+      bounds.Offset(-origin.x(), -origin.y());
+      // Read geometry only. Selection and navigation must still use Aura input.
+      popup->web_contents()->GetPrimaryMainFrame()->ExecuteJavaScriptForTests(
+          u"(()=>{function walk(root){const match=root.querySelector("
+          u"'cr-searchbox-match[selected]');if(match){const b=match."
+          u"getBoundingClientRect();if(b.width&&b.height)return [b.x,b.y,"
+          u"b.width,b.height];}for(const e of root.querySelectorAll('*'))"
+          u"if(e.shadowRoot){const b=walk(e.shadowRoot);if(b)return b;}"
+          u"return null;}return walk(document);})()",
+          base::BindOnce(
+              [](base::WeakPtr<Impl> self, uint64_t request, gfx::Rect bounds,
+                 base::Value result) {
+                if (!self) {
+                  return;
+                }
+                prts::Encoder e;
+                auto* rect = result.GetIfList();
+                std::array<double, 4> values = {};
+                bool ready = rect && rect->size() == 4;
+                for (size_t i = 0; i < 4; ++i) {
+                  ready =
+                      ready && ((*rect)[i].is_double() || (*rect)[i].is_int());
+                  values[i] = ready ? (*rect)[i].GetDouble() : 0;
+                  ready = ready && std::isfinite(values[i]);
+                }
+                // Auto-resize can briefly leave a 1x1/native old viewport
+                // alongside new DOM layout. Such geometry is not ready input.
+                ready = ready && values[0] >= 0 && values[1] >= 0 &&
+                        values[2] > 0 && values[3] > 0 &&
+                        // Native bounds round to integer DIP; DOM bounds can
+                        // retain a sub-DIP remainder. Return the full DOM rect
+                        // so the driver's owner-containment check stays exact.
+                        values[0] + values[2] < bounds.width() + 1.0 &&
+                        values[1] + values[3] < bounds.height() + 1.0;
+                for (size_t i = 0; i < 4; ++i) {
+                  double value = ready ? values[i] : 0;
+                  if (ready && i < 2) {
+                    value += i == 0 ? bounds.x() : bounds.y();
+                  }
+                  e.Int(std::bit_cast<uint64_t>(value), 8);
+                }
+                self->send_.Run(7, request, std::move(e.data));
+              },
+              weak_.GetWeakPtr(), r.id, bounds),
+          0);
+      return;
+    }
     if (r.type == 0x42c &&
         base::CommandLine::ForCurrentProcess()->HasSwitch("prts-test-hooks")) {
       if (!d.Done() || !windows_.contains(id)) {
@@ -910,10 +1005,21 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
           bounds.Offset(-origin.x(), -origin.y());
           menu_items.emplace_back(IDC_NEW_TAB, bounds);
         }
+        if (auto* result = views::AsViewClass<OmniboxResultView>(item);
+            result && result->GetMatchSelected()) {
+          auto bounds = item->GetBoundsInScreen();
+          bounds.Offset(-origin.x(), -origin.y());
+          // Test-only geometry marker for the selected omnibox suggestion.
+          menu_items.emplace_back(0x7fff0001, bounds);
+        }
         for (views::View* child : item->children()) {
           self(self, child);
         }
       };
+      for (views::Widget* widget :
+           views::Widget::GetAllChildWidgets(Root(windows_.at(id)))) {
+        collect(collect, widget->GetRootView());
+      }
       for (const auto& host : hosts) {
         for (views::Widget* widget :
              views::Widget::GetAllChildWidgets(host.root)) {
diff --git a/content/browser/renderer_host/aura_input_barrier.cc b/content/browser/renderer_host/aura_input_barrier.cc
index 5a4a3692c3..f51927d8a0 100644
--- a/content/browser/renderer_host/aura_input_barrier.cc
+++ b/content/browser/renderer_host/aura_input_barrier.cc
@@ -58,7 +58,12 @@ class AuraBarrier final : public WebContentsObserver,
     auto weak = weak_.GetWeakPtr();
     std::move(dispatch).Run();
     if (weak) {
-      PostPoll();
+      // A posted first check still observes asynchronous routing setup, while
+      // Views-consumed events need not wait for a delayed timer tick. Keep the
+      // pending-dispatch/ACK/state checks and delayed retries for renderer
+      // work.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&AuraBarrier::Poll, weak_.GetWeakPtr()));
     }
   }
   base::OnceClosure Cancellation() {
diff --git a/content/browser/renderer_host/render_widget_host_view_aura.cc b/content/browser/renderer_host/render_widget_host_view_aura.cc
index dccb33d0a8..277773e6d0 100644
--- a/content/browser/renderer_host/render_widget_host_view_aura.cc
+++ b/content/browser/renderer_host/render_widget_host_view_aura.cc
@@ -76,6 +76,7 @@
 #include "ui/aura/client/transient_window_client.h"
 #include "ui/aura/client/window_parenting_client.h"
 #include "ui/aura/env.h"
+#include "ui/aura/headless_root_size.h"
 #include "ui/aura/window.h"
 #include "ui/aura/window_event_dispatcher.h"
 #include "ui/aura/window_observer.h"
@@ -1330,8 +1331,16 @@ gfx::Rect RenderWidgetHostViewAura::GetBoundsInScreen() {
     // regular ones below.
     if (gfx::Rect* headless_bounds =
             host->window()->GetProperty(aura::client::kHeadlessBoundsKey)) {
-      return display::Screen::Get()->ScreenToDIPRectInWindow(top_level,
-                                                             *headless_bounds);
+      gfx::Rect logical_bounds =
+          display::Screen::Get()->ScreenToDIPRectInWindow(top_level,
+                                                        *headless_bounds);
+      // A streamed headless root excludes the invisible native resize frame.
+      // Keep DOM outer sizes consistent with its logical canvas and display.
+      if (const gfx::Size* canvas =
+              host->window()->GetProperty(aura::kHeadlessRootSizeKey)) {
+        logical_bounds.set_size(*canvas);
+      }
+      return logical_bounds;
     }
 
     RECT window_rect = {0};
