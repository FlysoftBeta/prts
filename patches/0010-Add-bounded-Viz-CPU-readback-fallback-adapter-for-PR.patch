+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_PRTS_PRTS_CAPTURE_H_
+#define CHROME_BROWSER_PRTS_PRTS_CAPTURE_H_
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "chrome/browser/prts/prts_protocol.h"
+#include "ui/gfx/geometry/size.h"
+namespace content {
+class WebContents;
+}
+namespace prts {
+// CPU readback FALLBACK adapter. M4 can replace the resource backend without
+// changing target ownership, subscription, pacing, or credit accounting.
+class PrtsCapture {
+ public:
+  using Send =
+      base::RepeatingCallback<void(uint16_t, uint64_t, std::vector<uint8_t>)>;
+  explicit PrtsCapture(Send send);
+  ~PrtsCapture();
+  void SetLimit(uint32_t limit);
+  bool CanSubscribe(uint64_t target) const;
+  void Configure(content::WebContents* contents,
+                 uint64_t target,
+                 uint64_t generation,
+                 gfx::Size size,
+                 uint32_t fps);
+  void Update(content::WebContents* contents,
+              uint64_t target,
+              uint64_t generation,
+              gfx::Size size);
+  void Remove(uint64_t target);
+  void Refresh(uint64_t target);
+  bool Receive(const Record& record);
+
+ private:
+  class Impl;
+  std::unique_ptr<Impl> impl_;
+};
+}  // namespace prts
+#endif
