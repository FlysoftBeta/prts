From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Tue, 20 Oct 2026 14:59:51 +0800
Subject: [PATCH 25/38] Correct headless outer bounds to requested PRTS root
 client size

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/chrome/browser/prts/prts_window_registry.cc b/chrome/browser/prts/prts_window_registry.cc
index b767ea756b..0530854649 100644
--- a/chrome/browser/prts/prts_window_registry.cc
+++ b/chrome/browser/prts/prts_window_registry.cc
@@ -229,6 +229,22 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
       w.display = display::HeadlessScreenManager::Get()->AddDisplay(monitor);
     }
     root->GetHost()->SetBoundsInPixels(pixels);
+    // DesktopWindowTreeHostWin passes outer bounds into its HWND handler,
+    // while GetBoundsInPixels reports the client. Headless custom frames still
+    // have invisible resize insets. Measure these after moving to the display
+    // (the insets depend on DSF), then correct the outer rectangle.
+    gfx::Rect outer = pixels;
+    for (int attempt = 0; attempt < 3; ++attempt) {
+      auto client = root->GetHost()->GetBoundsInPixels();
+      if (client == pixels) {
+        break;
+      }
+      outer.Offset(pixels.x() - client.x(), pixels.y() - client.y());
+      outer.set_size(
+          gfx::Size(outer.width() + pixels.width() - client.width(),
+                    outer.height() + pixels.height() - client.height()));
+      root->GetHost()->SetBoundsInPixels(outer);
+    }
   }
   void Scene(Window& w) {
     prts::Encoder e;
