diff --git a/chrome/browser/prts/prts_controller.cc b/chrome/browser/prts/prts_controller.cc
new file mode 100644
index 0000000000..56e6b27b71
--- /dev/null
+++ b/chrome/browser/prts/prts_controller.cc
@@ -0,0 +1,235 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/prts/prts_controller.h"
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/process/process_handle.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/lifetime/application_lifetime.h"
+#include "chrome/browser/prts/prts_target_registry.h"
+
+namespace prts {
+PrtsController::PrtsController() = default;
+PrtsController::~PrtsController() {
+  Stop();
+}
+void PrtsController::Prepare() {
+  VLOG(1) << "PRTS prepare";
+  targets_ = std::make_unique<PrtsTargetRegistry>(
+      base::BindRepeating(&PrtsController::Send, weak_factory_.GetWeakPtr()));
+  targets_->Prepare();
+}
+void PrtsController::Start() {
+  VLOG(1) << "PRTS start";
+  targets_->Start();
+  VLOG(1) << "PRTS startup targets removed";
+  started_ = last_received_ = base::TimeTicks::Now();
+  if (!pipe_.Start(base::BindRepeating(&PrtsController::Receive,
+                                       weak_factory_.GetWeakPtr()),
+                   base::BindRepeating(&PrtsController::Failed,
+                                       weak_factory_.GetWeakPtr()))) {
+    stopping_ = false;
+    Failed();
+    return;
+  }
+  timer_.Start(FROM_HERE, base::Seconds(1), this, &PrtsController::Tick);
+}
+void PrtsController::Stop() {
+  stopping_ = true;
+  ready_ = false;
+  timer_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  pipe_.Stop();
+  if (targets_) {
+    targets_->Stop();
+    targets_.reset();
+  }
+}
+void PrtsController::Failed() {
+  if (stopping_) {
+    return;
+  }
+  LOG(ERROR) << "PRTS connection failed";
+  if (ready_) {
+    ready_ = false;
+    stopping_ = true;
+    Encoder fault;
+    fault.Int(9, 4);
+    fault.String("PRTS connection failed");
+    fault.Int(1, 1);
+    // Best effort fatal diagnostic. The watchdog still bounds a blocked writer;
+    // pre-handshake failures close silently because ACK must be first.
+    if (pipe_.Send(8, 0, std::move(fault.data),
+                   base::BindOnce(
+                       [](base::WeakPtr<PrtsController> self) {
+                         if (self) {
+                           self->Stop();
+                           chrome::ExitIgnoreUnloadHandlers();
+                         }
+                       },
+                       weak_factory_.GetWeakPtr()))) {
+      return;
+    }
+  }
+  Stop();
+  chrome::ExitIgnoreUnloadHandlers();
+}
+void PrtsController::Tick() {
+  auto now = base::TimeTicks::Now();
+  if ((!ready_ && now - started_ > base::Seconds(5)) ||
+      now - last_received_ > base::Seconds(10) || pipe_.Stalled()) {
+    stopping_ = false;
+    Failed();
+  }
+}
+void PrtsController::Send(uint16_t type,
+                          uint64_t id,
+                          std::vector<uint8_t> payload) {
+  if (!ready_ || stopping_) {
+    return;
+  }
+  if (!pipe_.Send(type, id, std::move(payload))) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PrtsController::Failed, weak_factory_.GetWeakPtr()));
+  }
+}
+void PrtsController::Error(uint64_t id,
+                           uint32_t code,
+                           const std::string& message) {
+  Encoder e;
+  e.Int(code, 4);
+  e.String(message);
+  e.Int(0, 1);
+  if (!pipe_.Send(3, id, std::move(e.data))) {
+    Failed();
+  }
+}
+void PrtsController::Receive(Record record) {
+  VLOG(1) << "PRTS receive type=" << record.type << " id=" << record.id;
+  if (stopping_) {
+    return;
+  }
+  last_received_ = base::TimeTicks::Now();
+  // Only prtsd requests (odd, strictly increasing) and FAULT notifications
+  // are valid in M1. Resource responses/input become valid in later milestones.
+  if (record.type == 8 && ready_ && record.id == 0) {
+    Decoder d(record.payload);
+    d.Int(4);
+    d.String();
+    auto fatal = d.Int(1);
+    if (!d.Done() || fatal > 1 || fatal) {
+      Failed();
+    }
+    return;
+  }
+  if (!record.id || !(record.id & 1) || record.id <= last_request_) {
+    Failed();
+    return;
+  }
+  last_request_ = record.id;
+  Decoder d(record.payload);
+  if (!ready_) {
+    if (record.type != 1) {
+      Failed();
+      return;
+    }
+    auto min_major = d.Int(2), min_minor = d.Int(2);
+    auto max_major = d.Int(2), max_minor = d.Int(2);
+    auto daemon_pid = d.Int(4);
+    d.Int(8);
+    auto modes = d.Int(4), inflight = d.Int(4);
+    if (!d.Done() || !daemon_pid || !(modes & 2) || (modes & ~3u) ||
+        !inflight || inflight > 3) {
+      Failed();
+      return;
+    }
+    const auto parent =
+        base::GetParentProcessId(base::GetCurrentProcessHandle());
+    if (parent != daemon_pid) {
+      LOG(WARNING) << "PRTS HELLO PID differs from parent " << parent;
+    }
+    if (min_major > 1 || (min_major == 1 && min_minor > 0) || max_major < 1 ||
+        (max_major == min_major && max_minor < min_minor)) {
+      Encoder error;
+      error.Int(3, 4);
+      error.String("No common protocol version");
+      error.Int(0, 1);
+      stopping_ = true;
+      if (!pipe_.Send(3, record.id, std::move(error.data),
+                      base::BindOnce(
+                          [](base::WeakPtr<PrtsController> self) {
+                            if (self) {
+                              self->stopping_ = false;
+                              self->Failed();
+                            }
+                          },
+                          weak_factory_.GetWeakPtr()))) {
+        stopping_ = false;
+        Failed();
+      }
+      return;
+    }
+    Encoder ack;
+    ack.Int(1, 2);
+    ack.Int(0, 2);
+    ack.Int(base::GetCurrentProcId(), 4);
+    ack.Int(0, 8);
+    ack.Int(2, 4);
+    ack.Int(inflight, 4);
+    ack.Int(8192, 4);
+    ack.Int(8192, 4);
+    ack.Int(64000000, 4);
+    ack.Int(1, 4);
+    // Enqueue ACK before enabling any target notifications on the same writer.
+    if (!pipe_.Send(2, record.id, std::move(ack.data))) {
+      Failed();
+      return;
+    }
+    ready_ = true;
+    return;
+  }
+  if (record.type >= 0x100 && record.type <= 0x105) {
+    targets_->Handle(record.type, record.id, record.payload);
+    return;
+  }
+  if (record.type == 4) {
+    auto cookie = d.Int(8);
+    if (!d.Done()) {
+      Failed();
+      return;
+    }
+    Encoder pong;
+    pong.Int(cookie, 8);
+    Send(5, record.id, std::move(pong.data));
+  } else if (record.type == 6) {
+    if (!d.Done()) {
+      Failed();
+      return;
+    }
+    stopping_ = true;
+    // No frame resources exist in M1. Stop target production/observation, then
+    // wait for the serialized writer to finish OK before releasing keep-alives.
+    if (!pipe_.Send(7, record.id, {},
+                    base::BindOnce(
+                        [](base::WeakPtr<PrtsController> self) {
+                          if (self) {
+                            self->Stop();
+                            chrome::ExitIgnoreUnloadHandlers();
+                          }
+                        },
+                        weak_factory_.GetWeakPtr()))) {
+      stopping_ = false;
+      Failed();
+    }
+  } else if (record.type == 0x321) {
+    Error(record.id, 3, "Frame production is unavailable in M1");
+  } else {
+    // A known response on the command pipe, an unknown type, or input before
+    // the input milestone is a direction/type violation, never stream resync.
+    Failed();
+  }
+}
+}  // namespace prts
