diff --git a/chrome/browser/headless/chrome_browser_main_extra_parts_headless.cc b/chrome/browser/headless/chrome_browser_main_extra_parts_headless.cc
index e08b97b89c..ca80abe898 100644
--- a/chrome/browser/headless/chrome_browser_main_extra_parts_headless.cc
+++ b/chrome/browser/headless/chrome_browser_main_extra_parts_headless.cc
@@ -6,6 +6,11 @@
 
 #include "chrome/browser/headless/headless_mode_util.h"
 #include "components/headless/clipboard/headless_clipboard.h"
+#if BUILDFLAG(IS_WIN)
+#include "base/command_line.h"
+#include "chrome/browser/prts/prts_controller.h"
+#include "chrome/browser/prts/prts_switches.h"
+#endif
 
 namespace headless {
 
@@ -20,6 +25,32 @@ void ChromeBrowserMainExtraPartsHeadless::PreBrowserStart() {
   if (IsHeadlessMode()) {
     SetHeadlessClipboardForCurrentThread();
   }
+#if BUILDFLAG(IS_WIN)
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  if (command->GetSwitchValueASCII("headless") == "new" &&
+      command->GetSwitchValueASCII("type").empty() &&
+      command->HasSwitch(prts::kPipeSwitch)) {
+    prts_controller_ = std::make_unique<prts::PrtsController>();
+    prts_controller_->Prepare();
+  }
+#endif
+}
+
+void ChromeBrowserMainExtraPartsHeadless::PostBrowserStart() {
+#if BUILDFLAG(IS_WIN)
+  if (prts_controller_) {
+    prts_controller_->Start();
+  }
+#endif
+}
+
+void ChromeBrowserMainExtraPartsHeadless::PostMainMessageLoopRun() {
+#if BUILDFLAG(IS_WIN)
+  if (prts_controller_) {
+    prts_controller_->Stop();
+  }
+  prts_controller_.reset();
+#endif
 }
 
 }  // namespace headless
