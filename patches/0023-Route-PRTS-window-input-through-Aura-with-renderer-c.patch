+// renderer ACKs. Never injects a second renderer event. UI sequence only.
+// Returns cancellation for callers that invalidate their input epoch.
+CONTENT_EXPORT base::OnceClosure DispatchWithAuraInputBarrier(
+    WebContents*,
+    base::TimeTicks,
+    base::OnceClosure dispatch,
+    base::OnceCallback<void(bool)> done);
+CONTENT_EXPORT bool IsAuraContentTextClient(WebContents*,
+                                            const ui::TextInputClient*);
+CONTENT_EXPORT void FinishAuraTextCommit(WebContents*, base::OnceClosure done);
+}  // namespace content
+#endif
