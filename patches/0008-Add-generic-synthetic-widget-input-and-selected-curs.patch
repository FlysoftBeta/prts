+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CONTENT_PUBLIC_BROWSER_SYNTHETIC_INPUT_H_
+#define CONTENT_PUBLIC_BROWSER_SYNTHETIC_INPUT_H_
+#include <string>
+
+#include "base/functional/callback.h"
+#include "content/common/content_export.h"
+namespace input {
+struct NativeWebKeyboardEvent;
+}
+namespace blink {
+class WebMouseEvent;
+class WebMouseWheelEvent;
+}  // namespace blink
+namespace content {
+class WebContents;
+class RenderWidgetHost;
+// UI-only helpers. Routes through the ordinary RWH input router (including
+// asynchronous OOPIF targeting and root cursor selection), never the OS.
+CONTENT_EXPORT void RouteSyntheticMouse(WebContents*,
+                                        const blink::WebMouseEvent&,
+                                        base::OnceClosure done = {});
+CONTENT_EXPORT void RouteSyntheticWheel(WebContents*,
+                                        blink::WebMouseWheelEvent&,
+                                        base::OnceClosure done = {});
+CONTENT_EXPORT void SetSyntheticPageFocus(WebContents*, bool);
+CONTENT_EXPORT float SyntheticInputScale(WebContents*);
+CONTENT_EXPORT RenderWidgetHost* FocusedSyntheticInputWidget(WebContents*);
+CONTENT_EXPORT void CommitSyntheticText(RenderWidgetHost*,
+                                        const std::u16string&,
+                                        base::OnceClosure done);
+CONTENT_EXPORT void DispatchSyntheticKey(WebContents*,
+                                         const input::NativeWebKeyboardEvent&,
+                                         base::OnceClosure done);
+}  // namespace content
+#endif
