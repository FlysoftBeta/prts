+  void Prepare(Source& source) {
+    // A lone source can pipeline two frames. With two subscriptions each
+    // gets one credit, so a background source cannot starve the other.
+    size_t owned = 0;
+    for (const auto& [id, slot] : slots) {
+      if (!slot.retired && slot.target == source.target &&
+          slot.generation == source.generation) {
+        ++owned;
+      }
+    }
+    if (owned >=
+        std::min(source.max_inflight, sources.size() > 1 ? 1u : limit)) {
+      return;
+    }
+    // Includes registering and retired slots: transitions never multiply the
+    // pool.
+    if (slots.size() >= limit) {
+      if (layer_scheduling) {
+        // A private daemon cache outlives pool registration. Recycle one
+        // idle export slot for the least recently served waiting source,
+        // including a static popup with a single negotiated credit.
+        for (auto& [id, slot] : slots) {
+          if (!slot.retired && !slot.busy && !slot.request &&
+              slot.target != source.target) {
+            slot.retired = true;
+            Collect();
+            break;
+          }
+        }
+      }
+      VLOG(2) << "PRTS capture blocked target=" << source.target
+              << " pool full";
+      return;
+    }
+    Slot slot;
+    slot.id = ++next_buffer;
+    slot.target = source.target;
+    slot.generation = source.generation;
+    slot.size = source.size;
+    slot.mode = source.mode;
+    const size_t bytes = slot.size.GetArea() * 4ull;
+    if (slot.mode == 1) {
+      if (!gpu.Create(slot.size, slot.texture)) {
+        Fallback(source.target);
+        return;
+      }
+    } else {
+      slot.memory = base::ReadOnlySharedMemoryRegion::Create(bytes);
+      if (!slot.memory.IsValid()) {
+        return;
+      }
+    }
+    slot.request = next_request;
+    next_request += 2;
+    slot.requested_at = base::TimeTicks::Now();
+    Encoder e;
+    e.Int(slot.target, 8);
+    e.Int(slot.generation, 8);
+    e.Int(slot.id, 8);
+    e.Int(slot.mode, 1);
+    e.Int(reinterpret_cast<uintptr_t>(
+              slot.mode == 1 ? slot.texture.handle.Get()
+                             : slot.memory.region.GetPlatformHandle()),
+          8);
+    e.Int(slot.size.width(), 4);
+    e.Int(slot.size.height(), 4);
+    e.Int(source.format, 1);
+    e.Int(slot.mode == 1 ? 0 : slot.size.width() * 4, 4);
+    e.Int(slot.mode == 1 ? 0 : bytes, 8);
+    e.Int(slot.mode == 1 ? adapter_luid : 0, 8);
+    auto request = slot.request;
+    slots.emplace(slot.id, std::move(slot));
+    VLOG(1) << "PRTS capture register target=" << source.target
+            << " request=" << request;
+    send.Run(0x300, request, std::move(e.data));
+    return;
+  }
   void ResumeBlockedSources() {
+    if (layer_scheduling) {
+      Source* next = nullptr;
+      for (const auto& [id, source] : sources) {
+        if (source->waiting_for_credit && !source->recovering &&
+            (!next || std::tie(source->last_served, source->target) <
+                          std::tie(next->last_served, next->target))) {
+          next = source.get();
