+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_PRTS_PRTS_PIPE_CLIENT_WIN_H_
+#define CHROME_BROWSER_PRTS_PRTS_PIPE_CLIENT_WIN_H_
+
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "chrome/browser/prts/prts_protocol.h"
+
+namespace prts {
+// Called before ContentMain: validate browser-only launch and clear inheritance
+// before Chromium can create any subprocess. Does not adopt handles yet.
+bool ValidateLaunch();
+class PrtsPipeClient {
+ public:
+  PrtsPipeClient();
+  ~PrtsPipeClient();
+  bool Start(base::RepeatingCallback<void(Record)> receive,
+             base::RepeatingClosure failed);
+  bool Send(uint16_t type,
+            uint64_t id,
+            std::vector<uint8_t> payload,
+            base::OnceClosure written = {});
+  bool Stalled() const;
+  void Stop();
+
+ private:
+  struct State;
+  std::shared_ptr<State> state_;
+};
+}  // namespace prts
+#endif  // CHROME_BROWSER_PRTS_PRTS_PIPE_CLIENT_WIN_H_
diff --git a/chrome/browser/prts/prts_protocol.h b/chrome/browser/prts/prts_protocol.h
new file mode 100644
index 0000000000..2fb2ba54ba
--- /dev/null
+++ b/chrome/browser/prts/prts_protocol.h
@@ -0,0 +1,83 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_PRTS_PRTS_PROTOCOL_H_
+#define CHROME_BROWSER_PRTS_PRTS_PROTOCOL_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/memory/raw_span.h"
+#include "base/strings/string_util.h"
+
+namespace prts {
+constexpr uint32_t kMaxRecord = 1048576;
+struct Record {
+  uint16_t type = 0;
+  uint64_t id = 0;
+  std::vector<uint8_t> payload;
+};
+class Encoder {
+ public:
+  void Int(uint64_t value, size_t size) {
+    for (size_t i = 0; i < size; ++i) {
+      data.push_back(static_cast<uint8_t>(value >> (i * 8)));
+    }
+  }
+  void String(const std::string& value) {
+    Int(value.size(), 4);
+    data.insert(data.end(), value.begin(), value.end());
+  }
+  std::vector<uint8_t> data;
+};
+class Decoder {
+ public:
+  explicit Decoder(base::span<const uint8_t> data) : data_(data) {}
+  uint64_t Int(size_t size) {
+    if (size > data_.size()) {
+      valid_ = false;
+      return 0;
+    }
+    uint64_t value = 0;
+    for (size_t i = 0; i < size; ++i) {
+      value |= uint64_t{data_[i]} << (8 * i);
+    }
+    data_ = data_.subspan(size);
+    return value;
+  }
+  std::string String() {
+    size_t size = Int(4);
+    if (!valid_ || size > 65536 || size > data_.size()) {
+      valid_ = false;
+      return {};
+    }
+    auto bytes = data_.first(size);
+    std::string value(bytes.begin(), bytes.end());
+    data_ = data_.subspan(size);
+    valid_ &= base::IsStringUTF8(value);
+    return value;
+  }
+  bool Done() const { return valid_ && data_.empty(); }
+
+ private:
+  base::raw_span<const uint8_t> data_;
+  bool valid_ = true;
+};
+inline std::vector<uint8_t> Encode(uint16_t type,
+                                   uint64_t id,
+                                   std::vector<uint8_t> payload) {
+  Encoder e;
+  e.Int(20 + payload.size(), 4);
+  e.Int(0x53545250, 4);
+  e.Int(1, 2);
+  e.Int(0, 2);
+  e.Int(type, 2);
+  e.Int(0, 2);
+  e.Int(id, 8);
+  e.data.insert(e.data.end(), payload.begin(), payload.end());
+  return std::move(e.data);
+}
+}  // namespace prts
+#endif  // CHROME_BROWSER_PRTS_PRTS_PROTOCOL_H_
