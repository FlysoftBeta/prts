From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Tue, 20 Oct 2026 10:47:03 +0800
Subject: [PATCH 16/19] Transfer PRTS pipe thread ownership before asynchronous
 shutdown

Detach sequence checkers on their UI owner before the joining worker checks thread state; prevents a shutdown DCHECK exposed by GPU acceptance.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/chrome/browser/prts/prts_pipe_client_win.cc b/chrome/browser/prts/prts_pipe_client_win.cc
index 2d0ac9201a..fc75b2e782 100644
--- a/chrome/browser/prts/prts_pipe_client_win.cc
+++ b/chrome/browser/prts/prts_pipe_client_win.cc
@@ -292,6 +292,9 @@ void PrtsPipeClient::Stop() {
   auto state = std::move(state_);
   state->stopped.store(true);
   state->wake.Signal();
+  // Transfer sequence ownership on UI, before the worker checks IsRunning().
+  state->reader.DetachFromSequence();
+  state->writer.DetachFromSequence();
   // Joining runs off UI. Cancellation is repeated to close the small race
   // between checking stopped and entering synchronous ReadFile/WriteFile.
   base::ThreadPool::PostTask(
@@ -304,7 +307,6 @@ void PrtsPipeClient::Stop() {
               if (!thread->IsRunning()) {
                 continue;
               }
-              thread->DetachFromSequence();
               base::win::ScopedHandle handle(
                   OpenThread(THREAD_TERMINATE | SYNCHRONIZE, FALSE,
                              thread->GetThreadId().raw()));
