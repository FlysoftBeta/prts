+#ifndef CHROME_BROWSER_PRTS_PRTS_TARGET_REGISTRY_H_
+#define CHROME_BROWSER_PRTS_PRTS_TARGET_REGISTRY_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <vector>
+
+#include "base/functional/callback.h"
+
+// All entry points and callbacks run on the browser UI sequence. Wire
+// identities belong to WebContents, independently of their renderer or
+// containing window.
+class PrtsTargetRegistry {
+ public:
+  using SendCallback =
+      base::RepeatingCallback<void(uint16_t, uint64_t, std::vector<uint8_t>)>;
+
+  explicit PrtsTargetRegistry(SendCallback send);
+  ~PrtsTargetRegistry();
+  PrtsTargetRegistry(const PrtsTargetRegistry&) = delete;
+  PrtsTargetRegistry& operator=(const PrtsTargetRegistry&) = delete;
+
+  void Prepare();
+  void Start();
+  void Handle(uint16_t type,
+              uint64_t request_id,
+              const std::vector<uint8_t>& payload);
+  void Stop();
+
