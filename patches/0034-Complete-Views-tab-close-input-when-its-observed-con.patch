     timeout_.Stop();
     if (done_) {
       base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
diff --git a/ui/views/widget/desktop_aura/desktop_window_tree_host_win.cc b/ui/views/widget/desktop_aura/desktop_window_tree_host_win.cc
index 62eea1434a..ff387ea1e0 100644
--- a/ui/views/widget/desktop_aura/desktop_window_tree_host_win.cc
+++ b/ui/views/widget/desktop_aura/desktop_window_tree_host_win.cc
@@ -134,6 +134,9 @@ const int kMouseCaptureRegionBorder = 5;
 
 // Updates the cursor clip region. Used for mouse locking.
 void UpdateMouseLockRegion(aura::Window* window, bool locked) {
+  if (DesktopHeadlessInputEnabled()) {
+    return;
+  }
   if (!locked) {
     ::ClipCursor(nullptr);
     return;
@@ -1532,9 +1535,11 @@ void DesktopWindowTreeHostWin::HandleTouchEvent(ui::TouchEvent* event) {
     // mouse pointer. If the user has their mouse outside of the window when
     // this sync happens, when they move their mouse again it will show up in
     // it's original location.
-    if (touch_drag_cursor_sync && !window) {
+    if (touch_drag_cursor_sync && !window &&
+        !SuppressHeadlessNativeCursorCall()) {
       POINT event_point(event->location().x(), event->location().y());
       ::ClientToScreen(GetHWND(), &event_point);
+      RecordNativeCursorWrite();
       ::SetCursorPos(event_point.x, event_point.y);
     }
   }
diff --git a/ui/views/win/hwnd_message_handler.cc b/ui/views/win/hwnd_message_handler.cc
index 8bc517f7e9..f222cbeee6 100644
--- a/ui/views/win/hwnd_message_handler.cc
+++ b/ui/views/win/hwnd_message_handler.cc
@@ -2922,7 +2922,10 @@ LRESULT HWNDMessageHandler::OnSetCursor(UINT message,
       // Use the default value, IDC_ARROW.
       break;
   }
-  ::SetCursor(LoadCursor(nullptr, cursor));
+  if (!SuppressHeadlessNativeCursorCall()) {
+    RecordNativeCursorWrite();
+    ::SetCursor(LoadCursor(nullptr, cursor));
+  }
   return 1;
 }
 
