From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Tue, 20 Oct 2026 15:50:44 +0800
Subject: [PATCH 34/38] Complete Views tab-close input when its observed
 contents is destroyed

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/chrome/browser/prts/prts_target_registry.cc b/chrome/browser/prts/prts_target_registry.cc
index 523404530b..f8dd762dff 100644
--- a/chrome/browser/prts/prts_target_registry.cc
+++ b/chrome/browser/prts/prts_target_registry.cc
@@ -386,6 +386,7 @@ class PrtsTargetRegistry::Impl : public BrowserCollectionObserver,
     }
     profile_ = startup_profile->GetOriginalProfile();
     startup_profile->GetPrefs()->SetBoolean(prefs::kPrintingEnabled, false);
+    profile_->GetPrefs()->SetBoolean(prefs::kPrintingEnabled, false);
     off_the_record_ = startup_profile->IsOffTheRecord();
     profile_keep_alive_ = ScopedProfileKeepAlive::TryAcquire(
         profile_, ProfileKeepAliveOrigin::kHeadlessCommand);
diff --git a/chrome/browser/prts/prts_window_registry.cc b/chrome/browser/prts/prts_window_registry.cc
