+#include "content/public/browser/render_frame_host.h"
 #include "content/public/browser/web_contents.h"
 #include "content/public/browser/web_contents_observer.h"
 #include "ui/aura/headless_root_size.h"
@@ -47,6 +49,7 @@
 #include "ui/display/display.h"
 #include "ui/display/headless/headless_screen_manager.h"
 #include "ui/display/screen.h"
+#include "ui/views/focus/focus_manager.h"
 #include "ui/views/widget/desktop_aura/desktop_headless_input.h"
 #include "ui/views/widget/widget.h"
 #include "url/gurl.h"
@@ -658,6 +661,18 @@ class PrtsWindowRegistry::Impl : public BrowserCollectionObserver,
       e.Int(views::DesktopHeadlessInputEnabled(), 1);
       e.Int(views::BlockedHeadlessNativeCursorCalls(), 8);
       e.Int(views::NativeCursorWriteCalls(), 8);
+      std::set<content::RenderWidgetHost*> widgets;
+      if (auto* contents = Contents(id)) {
+        contents->ForEachRenderFrameHost([&](content::RenderFrameHost* frame) {
+          widgets.insert(frame->GetRenderWidgetHost());
+        });
+      }
+      e.Int(widgets.size(), 4);
+      e.String(base::UTF16ToUTF8(
+          view->GetLocationBarView()->GetOmniboxView()->GetText()));
+      auto* focused = view->GetWidget()->GetFocusManager()->GetFocusedView();
+      e.String(focused ? focused->GetClassName() : "none");
+      e.Int(view->GetWidget()->IsActive(), 1);
       send_.Run(0x48f, r.id, std::move(e.data));
       return;
     }
