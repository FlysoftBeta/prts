From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Wed, 21 Oct 2026 00:38:02 +0800
Subject: [PATCH 24/24] Support opt-in PRTS outer AppContainer provisioning and
 GPU qualification

Preserve paused isolation development: broker-owned state, package-aware child tokens, private desktops, Crashpad naming and active GPU diagnostics. Qualification remains incomplete.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/base/files/file_util_win.cc b/base/files/file_util_win.cc
index 4b3b7ee07b..99ecfc9eca 100644
--- a/base/files/file_util_win.cc
+++ b/base/files/file_util_win.cc
@@ -56,6 +56,7 @@
 #include "base/time/time.h"
 #include "base/uuid.h"
 #include "base/win/scoped_handle.h"
+#include "base/win/access_token.h"
 #include "base/win/security_util.h"
 #include "base/win/sid.h"
 #include "base/win/windows_types.h"
@@ -757,6 +758,18 @@ bool DirectoryExists(const FilePath& path) {
 }
 
 bool GetTempDir(FilePath* path) {
+  wchar_t tenant_temp[MAX_PATH + 1] = {};
+  const DWORD tenant_length = ::GetEnvironmentVariableW(
+      L"PRTS_TENANT_TEMP", tenant_temp, std::size(tenant_temp));
+  if (tenant_length > 0 && tenant_length < std::size(tenant_temp)) {
+    const auto token = win::AccessToken::FromCurrentProcess();
+    if (token && token->IsAppContainer()) {
+      // Windows redirects the standard LowBox TEMP variables to package data.
+      // The trusted PRTS launcher provisions this private, low-labelled path.
+      *path = FilePath(tenant_temp).StripTrailingSeparators();
+      return path->IsAbsolute() && DirectoryExists(*path);
+    }
+  }
   wchar_t temp_path[MAX_PATH + 1];
   DWORD path_len = ::GetTempPath(MAX_PATH, temp_path);
   if (path_len >= MAX_PATH || path_len <= 0) {
@@ -1101,6 +1114,19 @@ FilePath MakeLongFilePath(const FilePath& input) {
 
   DWORD path_long_len = ::GetLongPathName(input.value().c_str(), nullptr, 0);
   if (path_long_len == 0UL) {
+    // PRTS grants a LowBox access to its own state, without granting directory
+    // listing on the launch user's ancestors. GetLongPathName needs those
+    // ancestor permissions. Resolve the existing object by handle instead;
+    // this still canonicalizes reparse points and never trusts a lexical path
+    // for IsPathSafeToSetAclOn's containment check.
+    if (::GetEnvironmentVariableW(L"PRTS_SANDBOX_DESKTOP", nullptr, 0)) {
+      const auto token = win::AccessToken::FromCurrentProcess();
+      FilePath normalized;
+      if (token && token->IsAppContainer() &&
+          NormalizeFilePath(input, &normalized)) {
+        return normalized;
+      }
+    }
     return FilePath();
   }
 
