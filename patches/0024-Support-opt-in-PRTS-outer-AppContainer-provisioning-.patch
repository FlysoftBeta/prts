@@ -244,6 +247,38 @@ void PrtsController::Receive(Record record) {
     }
     return;
   }
+  if (record.type == 9) {
+    if (!d.Done()) {
+      Failed();
+      return;
+    }
+    // Report active info. The hardware-only cache can still describe Intel
+    // when the actual renderer has fallen back to SwiftShader or WARP.
+    auto* manager = content::GpuDataManagerImpl::GetInstance();
+    const auto info = manager->GetGPUInfo();
+    const auto& active = info.active_gpu();
+    const auto* host = content::GpuProcessHost::Get(
+        content::GPU_PROCESS_KIND_SANDBOXED, false);
+    Encoder result;
+    result.Int(host ? host->process_id() : 0, 4);
+    result.Int(active.vendor_id, 4);
+    result.Int(active.device_id, 4);
+    result.Int((static_cast<uint64_t>(static_cast<uint32_t>(active.luid.HighPart))
+                << 32) | active.luid.LowPart, 8);
+    result.Int(manager->HardwareAccelerationEnabled(), 1);
+    result.Int(info.UsesSwiftShader(), 1);
+    result.Int(info.sandboxed, 1);
+    result.String(active.driver_version);
+    result.String(info.gl_renderer);
+    result.String(info.gl_version);
+    const auto features = manager->GetGpuFeatureInfo();
+    result.Int(features.status_values.size(), 4);
+    for (const auto status : features.status_values) {
+      result.Int(status, 4);
+    }
+    Send(10, record.id, std::move(result.data));
+    return;
+  }
   if (major_ == 2 && record.type >= 0x400 && record.type <= 0x42f) {
     windows_->Handle(record);
     return;
