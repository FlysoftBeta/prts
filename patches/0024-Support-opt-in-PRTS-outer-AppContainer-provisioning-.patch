@@ -48,6 +50,27 @@ ResultCode AlternateDesktop::UpdateDesktopIntegrity(
 // true.
 ResultCode AlternateDesktop::Initialize(bool alternate_winstation) {
   DCHECK(!desktop_ && !winstation_);
+  // An AppContainer cannot create USER desktops/window stations. PRTS's
+  // fixed-purpose broker helper provisions this private sandbox desktop;
+  // the browser remains on its original desktop for GPU initialization.
+  // Do not apply this opt-in to normal Chromium or a non-AppContainer token.
+  wchar_t provisioned[256] = {};
+  const DWORD length = GetEnvironmentVariableW(
+      L"PRTS_SANDBOX_DESKTOP", provisioned, std::size(provisioned));
+  const auto token = base::win::AccessToken::FromCurrentProcess();
+  if (alternate_winstation && length > 0 && length < std::size(provisioned) &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch("prts-pipe") &&
+      token && token->IsAppContainer()) {
+    std::wstring name(provisioned);
+    if (!name.starts_with(L"prts.") || !name.ends_with(L".chromium_sandbox") ||
+        name.find(L'\\') != std::wstring::npos) {
+      return SBOX_ERROR_CANNOT_CREATE_DESKTOP;
+    }
+    desktop_ = OpenDesktopW(name.c_str(), 0, FALSE,
+                           DESKTOP_CREATEWINDOW | DESKTOP_READOBJECTS |
+                               READ_CONTROL | WRITE_DAC | WRITE_OWNER);
+    return desktop_ ? SBOX_ALL_OK : SBOX_ERROR_CANNOT_CREATE_DESKTOP;
+  }
   if (alternate_winstation) {
     // Create the window station.
     ResultCode result = CreateAltWindowStation(&winstation_);
