@@ -815,6 +816,16 @@ ResultCode SandboxWin::AddAppContainerProfileToConfig(
 bool SandboxWin::IsAppContainerEnabledForSandbox(
     const base::CommandLine& command_line,
     Sandbox sandbox_type) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("prts-pipe")) {
+    const auto token = base::win::AccessToken::FromCurrentProcess();
+    if (token && token->IsAppContainer()) {
+      // Restricted child tokens must retain the unique outer tenant package.
+      // Creating Chromium's ordinary shared service profiles from a LowBox
+      // broker is denied and would replace that identity. Keep the existing
+      // token/job/mitigation policies and inherit the outer package instead.
+      return false;
+    }
+  }
   if (!sandbox::features::IsAppContainerSandboxSupported())
     return false;
 
